<div class="container py-4">
	<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
		<h2 class="fw-bold text-primary m-0">Thông tin cá nhân</h2>
		<a href="/order/history" class="btn btn-outline-primary btn-sm">Xem lịch sử đơn hàng</a>
	</div>
	<div class="row g-4">
		<!-- Cập nhật Email + Họ tên -->
		<div class="col-lg-5">
			<form id="emailNameForm" method="POST" action="/profile/update-user" class="card shadow-sm p-4 mb-4">
				<h5 class="fw-bold mb-3">Cập nhật thông tin</h5>
				<div class="mb-3">
					<label for="fullName" class="form-label">Họ và tên</label>
					<input type="text" class="form-control" id="fullName" name="fullName" value="{{user.fullName}}"
						required>
				</div>
				<div class="mb-3">
					<label for="email" class="form-label">Email</label>
					<input type="email" class="form-control" id="email" name="email" value="{{user.email}}" required>
				</div>
				<div class="mb-3">
					<label for="points" class="form-label">Điểm tích lũy</label>
					<input type="number"  readonly class="form-control" id="points" name="points" value="{{user.point}}" required>
				</div>
				<button type="submit" class="btn btn-primary">Lưu</button>
			</form>

			<!-- Đổi mật khẩu -->
			<form id="passwordForm" method="POST" action="/profile/update-password" class="card shadow-sm p-4">
				<h5 class="fw-bold mb-3">Đổi mật khẩu</h5>
				<div class="mb-3">
					<label for="oldPassword" class="form-label">Mật khẩu hiện tại</label>
					<input type="password" class="form-control" id="oldPassword" name="oldPassword"
						placeholder="Nhập mật khẩu hiện tại" required>
				</div>
				<div class="mb-3">
					<label for="newPassword" class="form-label">Mật khẩu mới</label>
					<input type="password" class="form-control" id="newPassword" name="newPassword"
						placeholder="Nhập mật khẩu mới" required>
				</div>
				<div class="mb-3">
					<label for="confirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
					<input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
						placeholder="Nhập lại mật khẩu mới" required>
				</div>
				<button type="submit" class="btn btn-warning">Đổi mật khẩu</button>
			</form>
		</div>

		<!-- Danh sách địa chỉ -->
		<div class="col-lg-7">
			<div class="card shadow-sm p-4 mb-4">
				<h5 class="fw-bold mb-3">Địa chỉ giao hàng</h5>
				{{#if user.addresses.length}}
				<ul class="list-group mb-3">
					{{#each user.addresses}}
					<li class="list-group-item d-flex align-items-center address-item" data-address="{{this.address}}">
						<!-- Nút sửa/xóa -->
						<div class="address-view d-flex align-items-center flex-grow-1">
							<span class="address-text me-2">{{this.address}}</span>
						</div>
						<div class="d-flex align-items-center ms-2 gap-2 action-btns">
							<button type="button" class="btn btn-sm btn-outline-secondary btn-edit-address">Sửa</button>
							<form method="POST" action="/profile/addresses/me/{{this._id}}" class="d-inline">
								<input type="hidden" name="address" value="{{this}}">
								<button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
							</form>
						</div>
						<!-- Chỉnh sửa địa chỉ -->
						<form method="POST" action="/profile/addresses/me/update/{{this._id}}"
							class="address-edit-form d-none flex-grow-1 d-flex align-items-center gap-2 mb-0 ms-0">
							<input type="hidden" name="oldAddress" value="{{this.address}}">
							<input type="text" name="newAddress" class="form-control form-control-sm"
								value="{{this.address}}" required style="max-width:320px;">
							<button type="submit" class="btn btn-sm btn-primary">Lưu</button>
							<button type="button" class="btn btn-sm btn-outline-secondary btn-cancel-edit">Hủy</button>
						</form>
					</li>
					{{/each}}
				</ul>
				{{else}}
				<div class="text-muted mb-3">Chưa có địa chỉ nào.</div>
				{{/if}}

				<!-- Thêm địa chỉ mới -->
				<form method="POST" action="/profile/addresses/me" id="addAddressForm">
					<div class="row g-2 mb-2">
						<div class="col-md-4">
							<label class="form-label small">Tỉnh/Thành phố</label>
							<select class="form-select form-select-sm" id="provinceSelect" required>
								<option value="">-- Chọn tỉnh/thành phố --</option>
							</select>
						</div>
						<div class="col-md-4">
							<label class="form-label small">Quận/Huyện</label>
							<select class="form-select form-select-sm" id="districtSelect" disabled required>
								<option value="">-- Chọn quận/huyện --</option>
							</select>
						</div>
						<div class="col-md-4">
							<label class="form-label small">Phường/Xã</label>
							<select class="form-select form-select-sm" id="wardSelect" disabled required>
								<option value="">-- Chọn phường/xã --</option>
							</select>
						</div>
					</div>
					<div class="mb-2">
						<label class="form-label small">Địa chỉ chi tiết (số nhà, tên đường)</label>
						<input type="text" class="form-control form-control-sm" id="addressDetail" placeholder="Ví dụ: 123 Đường ABC" required>
					</div>
					<input type="hidden" name="newAddress" id="fullAddressInput">
					<button type="submit" class="btn btn-success btn-sm">Thêm địa chỉ</button>
				</form>
			</div>
		</div>
	</div>
</div>

<script>
	// Address edit/cancel handlers
	document.querySelectorAll('.btn-edit-address').forEach(btn => {
		btn.addEventListener('click', function () {
			const item = btn.closest('.address-item');
			item.querySelector('.address-view').classList.add('d-none');
			item.querySelector('.address-edit-form').classList.remove('d-none');
			item.querySelector('input[name="newAddress"]').focus();
			item.querySelector('.action-btns').classList.add('d-none');
		});
	});
	document.querySelectorAll('.btn-cancel-edit').forEach(btn => {
		btn.addEventListener('click', function () {
			const item = btn.closest('.address-item');
			item.querySelector('.address-edit-form').classList.add('d-none');
			item.querySelector('.address-view').classList.remove('d-none');
			item.querySelector('.action-btns').classList.remove('d-none');
		});
	});

	// Address form with province/district/ward dropdowns
	const API_BASE = 'https://api.mysupership.vn/v1/partner/areas';
	
	const provinceSelect = document.getElementById('provinceSelect');
	const districtSelect = document.getElementById('districtSelect');
	const wardSelect = document.getElementById('wardSelect');
	const addressDetail = document.getElementById('addressDetail');
	const fullAddressInput = document.getElementById('fullAddressInput');
	const addAddressForm = document.getElementById('addAddressForm');

	let provinces = [];
	let districts = [];
	let wards = [];
	let selectedProvince = null;
	let selectedDistrict = null;
	let selectedWard = null;

	// Load provinces
	async function loadProvinces() {
		try {
			const response = await fetch(`${API_BASE}/province`);
			const json = await response.json();
			provinces = json?.results || json?.data || [];
			
			provinceSelect.innerHTML = '<option value="">-- Chọn tỉnh/thành phố --</option>';
			provinces.forEach(p => {
				const option = document.createElement('option');
				option.value = p.code || p.id;
				option.textContent = p.name;
				option.dataset.name = p.name;
				provinceSelect.appendChild(option);
			});
		} catch (e) {
			console.error('Load provinces failed:', e);
		}
	}

	// Load districts by province
	async function loadDistricts(provinceCode) {
		try {
			const response = await fetch(`${API_BASE}/district?province=${provinceCode}`);
			const json = await response.json();
			districts = json?.results || json?.data || [];
			
			districtSelect.innerHTML = '<option value="">-- Chọn quận/huyện --</option>';
			districtSelect.disabled = false;
			wardSelect.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
			wardSelect.disabled = true;
			selectedDistrict = null;
			selectedWard = null;

			districts.forEach(d => {
				const option = document.createElement('option');
				option.value = d.code || d.id;
				option.textContent = d.name;
				option.dataset.name = d.name;
				districtSelect.appendChild(option);
			});
		} catch (e) {
			console.error('Load districts failed:', e);
		}
	}

	// Load wards by district
	async function loadWards(districtCode) {
		try {
			const response = await fetch(`${API_BASE}/commune?district=${districtCode}`);
			const json = await response.json();
			wards = json?.results || json?.data || [];
			
			wardSelect.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
			wardSelect.disabled = false;
			selectedWard = null;

			wards.forEach(w => {
				const option = document.createElement('option');
				option.value = w.code || w.id;
				option.textContent = w.name;
				option.dataset.name = w.name;
				wardSelect.appendChild(option);
			});
		} catch (e) {
			console.error('Load wards failed:', e);
		}
	}

	// Update full address
	function updateFullAddress() {
		const parts = [];
		const detail = addressDetail.value.trim();
		if (detail) parts.push(detail);
		if (selectedWard) parts.push(selectedWard);
		if (selectedDistrict) parts.push(selectedDistrict);
		if (selectedProvince) parts.push(selectedProvince);
		fullAddressInput.value = parts.join(', ');
	}

	// Province change
	provinceSelect.addEventListener('change', (e) => {
		const code = e.target.value;
		const option = e.target.options[e.target.selectedIndex];
		selectedProvince = option.dataset.name || '';
		if (code) {
			loadDistricts(code);
		} else {
			districtSelect.innerHTML = '<option value="">-- Chọn quận/huyện --</option>';
			districtSelect.disabled = true;
			wardSelect.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
			wardSelect.disabled = true;
			selectedDistrict = null;
			selectedWard = null;
		}
		updateFullAddress();
	});

	// District change
	districtSelect.addEventListener('change', (e) => {
		const code = e.target.value;
		const option = e.target.options[e.target.selectedIndex];
		selectedDistrict = option.dataset.name || '';
		if (code) {
			loadWards(code);
		} else {
			wardSelect.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
			wardSelect.disabled = true;
			selectedWard = null;
		}
		updateFullAddress();
	});

	// Ward change
	wardSelect.addEventListener('change', (e) => {
		const option = e.target.options[e.target.selectedIndex];
		selectedWard = option.dataset.name || '';
		updateFullAddress();
	});

	// Address detail input
	addressDetail.addEventListener('input', updateFullAddress);

	// Form submit
	addAddressForm.addEventListener('submit', (e) => {
		updateFullAddress();
		if (!fullAddressInput.value.trim()) {
			e.preventDefault();
			alert('Vui lòng nhập đầy đủ địa chỉ');
		}
	});

	// Initialize
	loadProvinces();
</script>