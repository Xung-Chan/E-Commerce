<div class="bg-secondary py-1 px-5">
    <div class="container-fluid ">
        <div class="row">
            <div class="col-12 col-md-auto mb-md-auto d-flex justify-content-center align-items-center">
                <span class="fw-bold text-white px-2" style="font-size: 1.1rem;">CoreStation - PC và linh kiện máy
                    tính</span>
            </div>
            <div class="col-12 col-md-auto ms-md-auto d-flex flex-wrap justify-content-center align-items-center"
                style="gap: 1rem;">
                {{#if isLoggedIn}}
                <span class="text-white fw-semibold px-2">Xin chào, {{user.fullName}}</span>
                <span class="text-white">|</span>
                <a href="/logout" class="text-white fw-semibold text-decoration-none px-2">Đăng xuất</a>
                {{else}}
                <a href="/login" class="text-white fw-semibold text-decoration-none px-2">Đăng nhập</a>
                <span class="text-white">|</span>
                <a href="/register" class="text-white fw-semibold text-decoration-none px-2">Đăng ký</a>
                {{/if}}
            </div>
        </div>
    </div>
</div>

<nav class="navbar navbar-expand-lg bg-primary py-2 px-5 shadow-lg">
    <div class="container-fluid">
        <!-- Toggler cho mobile -->
        <button class="navbar-toggler border-0 shadow-sm p-2 rounded-circle bg-light" type="button"
            data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
            aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse py-1" id="navbarContent">


            <div class="d-flex flex-column flex-lg-row align-items-lg-center w-100" style="gap: 1rem;">
                <!-- Logo -->
                <a class="navbar-brand ms-2" href="/">
                    <img src="/img/logo.png" alt="Logo" style="height:50px;">
                </a>

                <!-- Dropdown Menu -->
                <div class="dropdown">
                    <button class="btn btn-categories dropdown-toggle rounded-pill shadow" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false">
                        Danh mục sản phẩm
                    </button>

                    <!-- Dropdown menu content -->
                    <ul class="dropdown-menu shadow">
                        {{#if categories}}
                        {{#if categories.length}}
                        {{#each categories}}
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="/catalog?categoryId={{_id}}">
                                {{#if image}}
                                <img src="{{image}}" alt="{{name}}" width="28" height="28"
                                    class="rounded object-fit-cover"
                                    onerror="this.onerror=null;this.src='https://placehold.co/56x56?text=?';">
                                {{/if}}
                                <span>{{name}}</span>
                            </a>
                        </li>
                        {{/each}}
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <a class="dropdown-item fw-semibold text-primary" href="/catalog">
                                <i class="bi bi-list-ul me-1"></i> Xem tất cả
                            </a>
                        </li>
                        {{else}}
                        <li><span class="dropdown-item text-muted small">Chưa có danh mục</span></li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <a class="dropdown-item fw-semibold text-primary" href="/catalog">
                                <i class="bi bi-list-ul me-1"></i> Xem tất cả
                            </a>
                        </li>
                        {{/if}}
                        {{else}}
                        <li><span class="dropdown-item text-muted small">Đang tải...</span></li>
                        {{/if}}
                    </ul>
                </div>

                <!-- Thanh tìm kiếm -->
                <form class="d-flex align-items-center flex-grow-1" role="search" method="GET" action="/catalog">
                    <div class="input-group rounded-pill shadow" style="max-width: 500px;">
                        <input class="form-control rounded-start-pill ps-3" type="search" name="name"
                            placeholder="Tìm kiếm sản phẩm..." aria-label="Search"
                            value="{{#if query}}{{query.name}}{{/if}}">
                        <button class="btn btn-search rounded-end-pill px-3" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Hotline và Giỏ hàng -->
                {{#if isLoggedIn}}
                <div class="d-flex align-items-center ms-lg-auto" style="gap: 1rem;">
                    <a href="/cart"
                        class="btn btn-cart position-relative me-2 d-flex justify-content-center align-items-center shadow"
                        style="min-width: 120px;" title="Giỏ hàng">
                        <i class="bi bi-cart3" style="font-size: 1.5rem;"></i>
                        <span class="cart-label ms-1">Giỏ hàng</span>
                        <span
                            class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">{{totalCartItems}}</span>
                    </a>
                    
                    <a href="/profile" class="btn btn-user d-flex justify-content-center align-items-center me-2 shadow"
                        style="min-width: 120px;" title="Trang cá nhân">
                        <i class="bi bi-person-circle" style="font-size: 1.5rem;"></i>
                        <span class="user-label ms-2">Tài khoản</span>
                    </a>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</nav>