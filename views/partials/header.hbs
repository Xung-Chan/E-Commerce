<div class="bg-primary-dark py-2">
  <div class="container-fluid px-5">
    <div class="row align-items-center">
      <div class="col-12 col-md-auto mb-2 mb-md-0">
        <span class="fw-bold text-white px-2" style="font-size: 1.1rem;">CoreStation - PC và linh kiện máy tính</span>
      </div>
      <div class="col-12 col-md-auto ms-md-auto d-flex flex-wrap justify-content-end align-items-center"
        style="gap: 1rem;">
        {{#if isLoggedIn}}
        <span class="text-white fw-semibold px-2">Xin chào, {{user.name}}</span>
        <span class="text-white">|</span>
        <a href="/logout" class="text-white fw-semibold text-decoration-none px-2">Đăng xuất</a>
        {{else}}
        <a href="/login" class="text-white fw-semibold text-decoration-none px-2">Đăng nhập</a>
        <span class="text-white">|</span>
        <a href="/register" class="text-white fw-semibold text-decoration-none px-2">Đăng ký</a>
        {{/if}}
        <div>{{cc}}</div>
      </div>
    </div>
  </div>
</div>

<nav class="navbar navbar-expand-lg bg-primary py-2">
  <div class="container-fluid px-5">
    <!-- Logo -->
    <a class="navbar-brand main-logo me-2" href="/">
      <img src="/img/logo.png" alt="Logo" style="height:50px;">
    </a>

    <!-- Toggler cho mobile -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
      aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">
      <div class="d-flex flex-column flex-lg-row align-items-lg-center w-100" style="gap: 1rem;">
        <!-- Dropdown Menu -->
        <div class="dropdown me-lg-3">
          <button class="btn btn-categories dropdown-toggle w-100" type="button" data-bs-toggle="dropdown"
            aria-expanded="false">
            Danh mục sản phẩm
          </button>
          <ul class="dropdown-menu shadow">
            {{#if categories}}
            {{#if categories.length}}
            {{#each categories}}
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2" href="/catalog?category={{_id}}">
                {{#if image}}
                <img src="{{image}}" alt="{{name}}" width="28" height="28" class="rounded object-fit-cover"
                  onerror="this.onerror=null;this.src='https://placehold.co/56x56?text=?';">
                {{/if}}
                <span>{{name}}</span>
              </a>
            </li>
            {{/each}}
            <li>
              <hr class="dropdown-divider">
            </li>
            <li>
              <a class="dropdown-item fw-semibold text-primary" href="/catalog">
                <i class="bi bi-list-ul me-1"></i> Xem tất cả
              </a>
            </li>
            {{else}}
            <li><span class="dropdown-item text-muted small">Chưa có danh mục</span></li>
            <li>
              <hr class="dropdown-divider">
            </li>
            <li>
              <a class="dropdown-item fw-semibold text-primary" href="/catalog">
                <i class="bi bi-list-ul me-1"></i> Xem tất cả
              </a>
            </li>
            {{/if}}
            {{else}}
            <li><span class="dropdown-item text-muted small">Đang tải...</span></li>
            {{/if}}
          </ul>
        </div>

        <!-- Thanh tìm kiếm -->
        <form class="d-flex flex-grow-1 my-2 my-lg-0" role="search">
          <input class="form-control me-2" type="search" placeholder="Tìm kiếm sản phẩm..." aria-label="Search"
            style="min-width: 180px; max-width: 500px;">
          <button class="btn btn-search" type="submit">Tìm kiếm</button>
        </form>

        <!-- Hotline và Giỏ hàng -->
        <div class="d-flex align-items-center ms-lg-auto" style="gap: 1rem;">
          <div class="d-flex align-items-center hotline-box">
            <i class="bi bi-telephone-fill me-2" style="color: #3a86ff; font-size: 1.3rem;"></i>
            <span class="fw-bold text-primary" style="font-size: 1.1rem;">Hotline: 0988 123 456</span>
          </div>
          <button class="btn btn-cart position-relative me-2 d-flex justify-content-center align-items-center"
            type="button" style="min-width: 120px;">
            <i class="bi bi-cart3" style="font-size: 1.5rem;"></i>
            <span class="cart-label ms-2">Giỏ hàng</span>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
              0
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</nav>