<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm rounded mb-4">
                <div class="card-body p-4">
                    <h3 class="mb-4 text-primary fw-bold text-center">Đăng nhập</h3>
                    <form action="/api/auth/login" method="POST">
                        <div class="mb-3">
                            <label for="emailOrPhone" class="form-label fw-semibold">Email hoặc Số điện thoại</label>
                            <input name="email" type="text" class="form-control" id="emailOrPhone"
                                placeholder="Nhập email hoặc số điện thoại" required>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label fw-semibold">Mật khẩu</label>
                            <input name="password" type="password" class="form-control" id="password" placeholder="Nhập mật khẩu"
                                required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Đăng nhập</button>
                    </form>
                    <div class="text-center mt-5">
                        <span class="text-muted">Chưa có tài khoản?</span>
                        <a href="/register" class="text-primary fw-semibold text-decoration-underline ms-1">Đăng ký</a>
                    </div>
                </div>
            </div>
            <div class="card shadow-sm rounded">
                <div class="card-body p-4">
                    <div class="text-center mb-3 text-muted">Hoặc đăng nhập bằng</div>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="#" class="btn btn-outline-primary d-flex align-items-center">
                            <i class="bi bi-facebook me-2"></i> Facebook
                        </a>
                        <a href="#" class="btn btn-outline-danger d-flex align-items-center">
                            <i class="bi bi-google me-2"></i> Google
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>