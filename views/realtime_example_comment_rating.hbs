<div id="comment-list" >
     {{#each comments}}
        <li>
            {{this.content}}
        </li>
    {{/each}}
</div>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/socket_server.js"></script>
<script>
(function() {
    //Thay bằng productId của product đang xem detail

    let productId = "68cbff992bdc353b4acc3fa9";

    joinProductRoom(productId,
        (comment) => {
            const commentList = document.getElementById("comment-list");
            const newComment = document.createElement("li");
            newComment.textContent = comment.content;
            commentList.appendChild(newComment);
        },
        (rating) => {
            console.log("New rating received:", rating);
        }
    );
})();
</script>