<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm rounded">
                <div class="card-body p-4">
                    <h3 class="mb-4 text-primary fw-bold text-center">Quên mật khẩu</h3>

                    {{!-- Thông báo lỗi --}}
                    {{#if errorMessage}}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        {{errorMessage}}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {{/if}}


                    {{!-- Thông báo thành công --}}
                    {{#if successMessage}}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        {{successMessage}}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {{/if}}


                    {{!-- Form nhập email đổi mật khẩu --}}
                    <form method="POST" action="/forgot-password">
                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold">Email</label>
                            <input type="email" class="form-control" id="email" name="email"
                                placeholder="Nhập email của bạn" value="{{#if formData}}{{formData.email}}{{/if}}"
                                required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Gửi liên kết đặt lại</button>
                    </form>


                    {{!-- Trang đăng nhập --}}
                    <div class="text-center mt-4">
                        <a href="/login" class="text-decoration-underline">Quay lại đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>