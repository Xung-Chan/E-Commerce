<div class="container py-5" id="orderResultPage">
	<div class="text-center mb-4">
		<h2 class="fw-bold text-success">Đặt hàng thành công!</h2>
		<p class="text-muted mb-1">Mã đơn hàng: <span id="orderIdDisplay" class="fw-semibold">{{orderId}}</span></p>
		<p class="text-muted">Cảm ơn bạn đã mua sắm tại CoreStation.</p>
		<a href="/catalog" class="btn btn-outline-primary btn-sm">Tiếp tục mua sắm</a>
		<a href="/order/history" class="btn btn-outline-secondary btn-sm">Xem lịch sử đơn hàng</a>
	</div>

	{{#if errorMessage}}
	<div class="alert alert-warning text-center">{{errorMessage}}</div>
	{{/if}}

	<div class="row g-4">
		<div class="col-lg-8">
			<div class="card shadow-sm mb-4">
				<div class="card-header bg-white fw-semibold">Thông tin đơn hàng</div>
				<div class="card-body">
					<div class="mb-3">
						<strong>Người nhận:</strong> <span>{{order.fullName}}</span>
					</div>
					<div class="mb-3">
						<strong>Email:</strong> <span>{{order.email}}</span>
					</div>
					<div class="mb-3">
						<strong>Địa chỉ giao hàng:</strong> <span>{{order.address}}</span>
					</div>
				</div>
			</div>

			<div class="card shadow-sm mb-4">
				<div class="card-header bg-white fw-semibold">Sản phẩm trong đơn</div>
				<div class="card-body">
					{{#if order.items}}
						{{#each order.items}}
						<div class="d-flex justify-content-between border-bottom py-3">
							<div class="me-2 flex-grow-1">
								<div class="fw-semibold">{{this.productName}}</div>
								{{#if this.distinctFeature}}
								<div class="small text-muted">{{this.distinctFeature}}</div>
								{{/if}}
								<div class="small">Số lượng: x{{this.quantity}}</div>
							</div>
							<div class="text-end">
								<div class="fw-semibold text-danger">{{formatPrice this.price}} VND</div>
							</div>
						</div>
						{{/each}}
					{{else}}
					<div class="text-muted small">Không có sản phẩm</div>
					{{/if}}
				</div>
			</div>

			{{#if order.status}}
			<div class="card shadow-sm">
				<div class="card-header bg-white fw-semibold">Trạng thái đơn hàng</div>
				<div class="card-body">
					{{#each order.status}}
					<div class="mb-2">
						<span class="badge bg-primary">{{this.status}}</span>
						<span class="small text-muted ms-2">{{formatDate this.createdAt}}</span>
					</div>
					{{/each}}
				</div>
			</div>
			{{/if}}
		</div>

		<div class="col-lg-4">
			<div class="card shadow-sm position-sticky" style="top:20px;">
				<div class="card-header bg-white fw-semibold">Tóm tắt thanh toán</div>
				<div class="card-body">
					<ul class="list-group list-group-flush mb-3">
						<li class="list-group-item d-flex justify-content-between">
							<span>Tạm tính:</span>
							<span id="subtotalDisplay">{{formatPrice order.totalPrice}} VND</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							<span>Tổng giảm giá:</span>
							<span id="discountDisplay" class="text-success">-{{formatPrice order.totalDiscount}} VND</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							<span>Phí vận chuyển:</span>
							<span id="shippingFeeDisplay">{{formatPrice order.shippingFee}} VND</span>
						</li>
						<li class="list-group-item d-flex justify-content-between fw-bold text-danger">
							<span>Tổng thanh toán:</span>
							<span id="totalPayDisplay">{{formatPrice order.totalPay}} VND</span>
						</li>
					</ul>
					<div class="mb-2 small">
						<strong>Phương thức vận chuyển:</strong><br>
						<span>{{order.shippingMethod}}</span>
					</div>
					<div class="small">
						<strong>Phương thức thanh toán:</strong><br>
						<span>COD (Thanh toán khi nhận hàng)</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
