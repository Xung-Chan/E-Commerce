<div class="container my-5">
	<div class="row justify-content-center">
		<div class="col-md-6 col-lg-5">
			<div class="card shadow-sm rounded">
				<div class="card-body p-4">
					<h3 class="mb-4 text-primary fw-bold text-center">Đặt lại mật khẩu</h3>

					{{#if errorMessage}}
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						{{errorMessage}}
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
					{{/if}}

					{{#if successMessage}}
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						{{successMessage}}
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
					{{/if}}

					<form method="POST" action="/reset-password">
						<input type="hidden" name="token" value="{{token}}" />
						<div class="mb-3">
							<label for="newPassword" class="form-label fw-semibold">Mật khẩu mới</label>
							<input type="password" class="form-control {{#if (hasFieldError errors 'newPassword')}}is-invalid{{/if}}" id="newPassword" name="newPassword" placeholder="Nhập mật khẩu mới" required />
							{{> form-field-errors name='newPassword' errors=errors}}
						</div>
						<div class="mb-3">
							<label for="confirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu</label>
							<input type="password" class="form-control {{#if (hasFieldError errors 'confirmPassword')}}is-invalid{{/if}}" id="confirmPassword" name="confirmPassword" placeholder="Nhập lại mật khẩu" required />
							{{> form-field-errors name='confirmPassword' errors=errors}}
						</div>
						<button type="submit" class="btn btn-primary w-100 fw-bold">Cập nhật mật khẩu</button>
					</form>

					<div class="text-center mt-4">
						<a href="/login" class="text-decoration-underline">Quay lại đăng nhập</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
