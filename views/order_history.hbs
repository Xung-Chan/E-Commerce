<div class="container py-4">
  <h2 class="fw-bold mb-3">Lịch sử đơn hàng</h2>

  {{#if errorMessage}}
    <div class="alert alert-danger">{{errorMessage}}</div>
  {{/if}}

  <form id="filtersForm" class="card mb-6">
    <div class="card-body row g-3 align-items-end">
      <div class="col-sm-6 col-md-6">
        <label for="status" class="form-label">Trạng thái</label>
        <select class="form-select" id="status" name="status">
          <option value="" {{#unless query.status}}selected{{/unless}}>Tất cả</option>
          <option value="pending" {{#if (eq query.status "pending")}}selected{{/if}}>Đang xử lý</option>
          <option value="confirmed" {{#if (eq query.status "confirmed")}}selected{{/if}}>Đã xác nhận</option>
          <option value="shipping" {{#if (eq query.status "shipping")}}selected{{/if}}>Đang giao</option>
          <option value="completed" {{#if (eq query.status "completed")}}selected{{/if}}>Hoàn tất</option>
          <option value="canceled" {{#if (eq query.status "canceled")}}selected{{/if}}>Đã hủy</option>
        </select>
      </div>
      <div class="col-sm-6 col-md-3">
        <label for="sortOrder" class="form-label">Thời gian đặt</label>
        <select class="form-select" id="sortOrder" name="sortOrder">
          <option value="desc" {{#if (eq query.sortOrder "desc")}}selected{{/if}}>Giảm dần</option>
          <option value="asc" {{#if (eq query.sortOrder "asc")}}selected{{/if}}>Tăng dần</option>
        </select>
      </div>
      <div class="col-sm-6 col-md-3">
        <label for="limit" class="form-label">Mỗi trang</label>
        <select class="form-select" id="limit" name="limit">
          <option value="5" {{#if (eq query.limit 5)}}selected{{/if}}>5</option>
          <option value="10" {{#if (eq query.limit 10)}}selected{{/if}}>10</option>
          <option value="20" {{#if (eq query.limit 20)}}selected{{/if}}>20</option>
        </select>
      </div>
      <div class="col-12 d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">Áp dụng</button>
      </div>
    </div>
  </form>

  {{#if orders.length}}
    <div class="card">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>Trạng thái</th>
              <th>Sản phẩm</th>
              <th>Tổng</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each orders}}
              <tr>
                <td><span class="text-muted">{{this.id}}</span></td>
                <td><span class="badge bg-secondary text-capitalize">{{this.currentStatus}}</span></td>
                <td>
                  {{#each this.items}}
                    <div class="small text-muted">- {{this.productName}} ({{this.distinctFeature}}) x{{this.quantity}}</div>
                  {{/each}}
                </td>
                <td><strong>{{formatPrice this.totalPay}} VNĐ</strong></td>
                <td class="text-end">
                  <a href="/order/result/{{this.id}}" class="btn btn-outline-primary btn-sm">Chi tiết</a>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

    <nav class="mt-3 d-flex justify-content-center">
      <ul class="pagination mb-0">
        {{#unless isFirstPage}}
          <li class="page-item"><a class="page-link" href="?page={{prevPage}}{{#if baseQueryString}}&{{baseQueryString}}{{/if}}">Trước</a></li>
        {{/unless}}
        {{#each pages}}
          <li class="page-item {{#if this.active}}active{{/if}}">
            <a class="page-link" href="?page={{this.number}}{{#if ../baseQueryString}}&{{../baseQueryString}}{{/if}}">{{this.number}}</a>
          </li>
        {{/each}}
        {{#unless isLastPage}}
          <li class="page-item"><a class="page-link" href="?page={{nextPage}}{{#if baseQueryString}}&{{baseQueryString}}{{/if}}">Tiếp</a></li>
        {{/unless}}
      </ul>
    </nav>
  {{else}}
    <div class="alert alert-info">Bạn chưa có đơn hàng nào.</div>
  {{/if}}
</div>

<script>
(function(){
  const form = document.getElementById('filtersForm');
  if(!form) return;
  form.addEventListener('submit', function(e){
    e.preventDefault();
    const params = new URLSearchParams(window.location.search);
    const status = form.status.value || '';
    // sortBy removed per request
    const sortOrder = form.sortOrder.value || 'desc';
    const limit = form.limit.value || '10';
    params.set('page', '1');
    if(status) params.set('status', status); else params.delete('status');
    params.set('sortOrder', sortOrder);
    params.set('limit', limit);
    window.location.search = params.toString();
  });
})();
</script>
