<div class="container my-5">
    <!-- Toast Container - Fixed position -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        {{#if successMessage}}
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true" style="min-width: 300px;">
            <div class="toast-header bg-success text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                    class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
                    <path
                        d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.061L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                </svg>
                <strong class="me-auto">Thành công</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"
                    aria-label="Close"></button>
            </div>
            <div class="toast-body bg-white">
                {{successMessage}}
                {{#if showLoginLink}}
                <hr class="my-2">
                <div class="text-center">
                    <a href="/login" class="btn btn-success btn-sm">Đi đến trang đăng nhập</a>
                </div>
                {{/if}}
            </div>
        </div>
        {{/if}}
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm rounded mb-4">
                <div class="card-body p-4">
                    <h3 class="mb-4 text-primary fw-bold text-center">Đăng ký</h3>

                    <!-- Server Messages -->
                    {{#if errorMessage}}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        {{errorMessage}}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {{/if}}

                    <!-- Registration Form -->
                    <form id="registerForm" method="POST" action="/register">
                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold">Email</label>
                            <input type="email"
                                class="form-control {{#if (hasFieldError errors 'email')}}is-invalid{{/if}}" id="email"
                                name="email" placeholder="Nhập email" value="{{#if formData}}{{formData.email}}{{/if}}"
                                required>
                            {{#if (getFieldError errors 'email')}}
                            <div class="invalid-feedback">{{getFieldError errors 'email'}}</div>
                            {{/if}}
                        </div>
                        <div class="mb-3">
                            <label for="fullName" class="form-label fw-semibold">Họ tên người dùng</label>
                            <input type="text"
                                class="form-control {{#if (hasFieldError errors 'fullName')}}is-invalid{{/if}}"
                                id="fullName" name="fullName" placeholder="Nhập họ tên"
                                value="{{#if formData}}{{formData.fullName}}{{/if}}" required>
                            {{#if (getFieldError errors 'fullName')}}
                            <div class="invalid-feedback">{{getFieldError errors 'fullName'}}</div>
                            {{/if}}
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label fw-semibold">Mật khẩu</label>
                            <input type="password"
                                class="form-control {{#if (hasFieldError errors 'password')}}is-invalid{{/if}}"
                                id="password" name="password" placeholder="Nhập mật khẩu" required minlength="6">
                            {{#if (getFieldError errors 'password')}}
                            <div class="invalid-feedback">{{getFieldError errors 'password'}}</div>
                            {{/if}}
                            <small class="form-text text-muted">Mật khẩu tối thiểu 6 ký tự</small>
                        </div>
                        <div class="mb-5">
                            <label for="address" class="form-label fw-semibold">Địa chỉ giao hàng</label>
                            <input type="text"
                                class="form-control {{#if (hasFieldError errors 'address')}}is-invalid{{/if}}"
                                id="address" name="address" placeholder="Nhập địa chỉ giao hàng"
                                value="{{#if formData}}{{formData.address}}{{/if}}" required>
                            {{#if (getFieldError errors 'address')}}
                            <div class="invalid-feedback">{{getFieldError errors 'address'}}</div>
                            {{/if}}
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold" id="submitBtn">
                            Đăng ký
                        </button>
                    </form>

                    {{!-- Login Link --}}
                    <div class="text-center mt-5">
                        <span class="text-muted">Đã có tài khoản?</span>
                        <a href="/login" class="text-primary fw-semibold text-decoration-underline ms-1">Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{!-- Validation Scripts --}}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Auto-hide success toast after 5 seconds
        const successToast = document.querySelector('.toast.show');
        if (successToast) {
            setTimeout(() => {
                const toastBootstrap = new bootstrap.Toast(successToast);
                toastBootstrap.hide();
            }, 5000);
        }

        const registerForm = document.getElementById('registerForm');
        const inputs = registerForm.querySelectorAll('.form-control');

        inputs.forEach(input => {
            input.addEventListener('blur', function () {
                validateField(this);
            });

            input.addEventListener('input', function () {
                if (this.classList.contains('is-invalid')) {
                    this.classList.remove('is-invalid');
                    const feedback = this.parentNode.querySelector('.invalid-feedback');
                    if (feedback) feedback.style.display = 'none';
                }
            });
        });

        function validateField(field) {
            const value = field.value.trim();
            let isValid = true;
            let message = '';

            if (!value) {
                isValid = false;
                message = 'Trường này không được để trống';
            } else {
                switch (field.type) {
                    case 'email':
                        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                        if (!emailRegex.test(value)) {
                            isValid = false;
                            message = 'Email không hợp lệ';
                        }
                        break;
                    case 'password':
                        if (value.length < 6) {
                            isValid = false;
                            message = 'Mật khẩu phải có ít nhất 6 ký tự';
                        }
                        break;
                }
            }

            if (!isValid) {
                field.classList.add('is-invalid');
                let feedback = field.parentNode.querySelector('.invalid-feedback');
                if (!feedback) {
                    feedback = document.createElement('div');
                    feedback.className = 'invalid-feedback';
                    field.parentNode.appendChild(feedback);
                }
                feedback.textContent = message;
                feedback.style.display = 'block';
            } else {
                field.classList.remove('is-invalid');
                const feedback = field.parentNode.querySelector('.invalid-feedback');
                if (feedback) feedback.style.display = 'none';
            }

            return isValid;
        }

        registerForm.addEventListener('submit', function (e) {
            let formValid = true;
            inputs.forEach(input => {
                if (!validateField(input)) {
                    formValid = false;
                }
            });
            if (!formValid) {
                e.preventDefault();
                const firstError = registerForm.querySelector('.is-invalid');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    firstError.focus();
                }
            }
        });
    });
</script>