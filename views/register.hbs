<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm rounded mb-4">
                <div class="card-body p-4">
                    <h3 class="mb-4 text-primary fw-bold text-center">Đăng ký</h3>
                    <!-- Server Messages -->
                    {{#if errorMessage}}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        {{errorMessage}}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {{/if}}

                    <!-- Registration Form -->
                    <form id="registerForm" method="POST" action="/register">
                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold">Email</label>
                            <input type="email"
                                class="form-control {{#if (hasFieldError errors 'email')}}is-invalid{{/if}}" id="email"
                                name="email" placeholder="Nhập email" value="{{#if formData}}{{formData.email}}{{/if}}"
                                required>
                            {{#if (getFieldError errors 'email')}}
                            <div class="invalid-feedback">{{getFieldError errors 'email'}}</div>
                            {{/if}}
                        </div>
                        <div class="mb-3">
                            <label for="fullName" class="form-label fw-semibold">Họ và tên</label>
                            <input type="text"
                                class="form-control {{#if (hasFieldError errors 'fullName')}}is-invalid{{/if}}"
                                id="fullName" name="fullName" placeholder="Nhập họ và tên"
                                value="{{#if formData}}{{formData.fullName}}{{/if}}" required>
                            {{#if (getFieldError errors 'fullName')}}
                            <div class="invalid-feedback">{{getFieldError errors 'fullName'}}</div>
                            {{/if}}
                        </div>
                        {{!-- Password field removed as requested --}}
                        <div class="mb-5">
                            <label for="address" class="form-label fw-semibold">Địa chỉ giao hàng</label>
                            <input type="text"
                                class="form-control {{#if (hasFieldError errors 'address')}}is-invalid{{/if}}"
                                id="address" name="address" placeholder="Nhập địa chỉ giao hàng"
                                value="{{#if formData}}{{formData.address}}{{/if}}" required>
                            {{#if (getFieldError errors 'address')}}
                            <div class="invalid-feedback">{{getFieldError errors 'address'}}</div>
                            {{/if}}
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold" id="submitBtn">
                            Đăng ký
                        </button>
                    </form>

                    {{!-- Login Link --}}
                    <div class="text-center mt-5">
                        <span class="text-muted">Đã có tài khoản?</span>
                        <a href="/login" class="text-primary fw-semibold text-decoration-underline ms-1">Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const successToast = document.querySelector('.toast.show');
        if (successToast) {
            setTimeout(() => {
                const toastBootstrap = new bootstrap.Toast(successToast);
                toastBootstrap.hide();
            }, 5000);
        }
    });
</script>