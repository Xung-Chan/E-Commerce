<div class="container py-4 product-page">
    <div class="row g-4 align-items-stretch">
        <!-- Ảnh sản phẩm -->
        <div class="col-lg-6 h-100">
            <div class="ratio ratio-4x3 border rounded mb-3 bg-white d-flex align-items-center justify-content-center">
                <img id="mainImage" src="{{product.images.[0]}}" alt="{{product.name}}"
                    class="w-100 h-100 object-fit-contain p-2"
                    onerror="this.onerror=null;this.src='https://placehold.co/600x400?text={{product.name}}';">
            </div>
            <div class="d-flex justify-content-between mt-3" style="width: 100%;">
                {{#each product.images}}
                <button type="button" class="p-0 border rounded thumb-btn"
                    style="width: 100px; height: 100px; overflow: hidden; background: #fff;">
                    <img src="{{this}}" alt="{{../product.name}}" class="w-100 h-100 object-fit-cover"
                        onerror="this.onerror=null;this.src='https://placehold.co/100x100?text=No+Img';">
                </button>
                {{/each}}
            </div>
        </div>


        <!-- Thông tin sản phẩm -->
        <div class="col-lg-6 d-flex flex-column h-100 info-col">
            <div class="top-info">
                <h2 class="fw-bold mb-3 text-primary">{{product.name}}</h2>
                <div class="mb-3">
                    <span class="text-muted">Thương hiệu:</span>
                    <strong class="ms-2">{{brand.name}}</strong>
                </div>
                <div class="mb-3">
                    <span class="text-muted">Danh mục:</span>
                    <strong class="ms-2">{{category.name}}</strong>
                </div>
                <div class="desc-scroll mb-3" style="max-height: 120px; overflow-y: auto;">
                    <span class="text-muted">Mô tả:</span>
                    <div class="mt-2">{{product.description}}</div>
                </div>
            </div>


            <!-- Cấu hình -->
            <div class="mb-3">
                <span class="text-muted">Cấu hình:</span>
                <div class="btn-group-vertical w-100 mt-2" role="group" aria-label="Chọn cấu hình">
                    {{#each product.variants}}
                    <button type="button"
                        class="variant-btn btn mb-2 {{#if @first}}btn-primary text-white{{else}}btn-outline-primary{{/if}}"
                        data-price="{{this.price}}" data-feature="{{this.distinctFeature}}" data-stock="{{this.stock}}"
                        data-variant-id="{{this._id}}" style="text-align:left; padding: 12px 16px;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-cpu me-2"></i>{{this.distinctFeature}}
                            </div>
                            <div class="fw-bold text-end">
                                {{formatPrice this.price}} VNĐ
                            </div>
                        </div>
                        <small class="text-muted d-block mt-1">Còn lại: {{this.stock}} sản phẩm</small>
                    </button>
                    {{/each}}
                </div>
            </div>


            <!-- Giá và số lượng hiện có -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Giá:</span>
                    <span id="productPrice" class="fs-4 fw-bold text-danger">
                        {{#if selectedVariant}}{{formatPrice selectedVariant.price}} VNĐ{{else}}{{formatPrice
                        product.variants.[0].price}} VNĐ{{/if}}
                    </span>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="text-muted">Kho:</span>
                    <span id="productStock" class="fw-bold">
                        {{#if
                        selectedVariant}}{{selectedVariant.stock}}{{else}}{{product.variants.[0].stock}}{{/if}}
                        sản phẩm
                    </span>
                </div>
                <label class="text-muted">Số lượng:</label>
                <div class="d-flex align-items-center mt-2 gap-2">
                    <button class="btn btn-outline-secondary" id="qtyMinus">−</button>
                    <input type="number" id="qtyInput" value="1" min="1" class="form-control" style="width:80px;">
                    <button class="btn btn-outline-secondary" id="qtyPlus">+</button>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-3 mb-4">
                <button class="btn btn-success px-4" id="orderNowBtn" data-product-id="{{product._id}}">Đặt
                    hàng</button>
                {{#if isLoggedIn}}
                <button class="btn btn-outline-primary px-4" id="addToCartBtn" data-product-id="{{product._id}}">Thêm
                    vào
                    giỏ</button>
                {{/if}}
            </div>
            <form id="addToCartForm" action="/product/add-to-cart" method="POST" style="display:none;">
                <input type="hidden" name="variantId" id="formVariantId">
                <input type="hidden" name="quantity" id="formQuantity">
            </form>

        </div>
    </div>


    <!-- Đánh giá & Bình luận -->
    <div class="mt-5">
        <h4 class="fw-bold mb-3">Đánh giá & Bình luận</h4>

        <!-- Trung bình rating sản phẩm -->
        <div class="row mb-3">
            <div class="col-auto">
                <div class="d-flex align-items-center gap-3 bg-white border rounded p-3 shadow-sm">
                    <div class="display-5 fw-bold mb-0 text-primary text-center" style="min-width:60px; width:80px;">
                        {{productRating}}
                    </div>
                    <div>
                        <div style="letter-spacing:2px;">
                            {{#each stars}}
                            {{#if (lte this ../productRating)}}
                            <span class="text-warning" style="font-size:1.7rem;">★</span>
                            {{else}}
                            <span class="text-secondary" style="font-size:1.7rem;">★</span>
                            {{/if}}
                            {{/each}}
                        </div>
                        <div class="text-muted small">Đánh giá trung bình</div>
                    </div>
                </div>
            </div>
        </div>


        <div class="row g-4 d-flex align-items-stretch">
            {{#if isLoggedIn}}
                {{#if userRating}}
                <div class="col-auto mb-3 d-flex align-items-stretch">
                    <div class="card flex-fill p-3" style="min-width:260px; width:auto;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:44px; height:44px; background:#fff7e6; border:1px solid #ffe8b0;">
                                <span class="text-warning" style="font-size:1.2rem;">★</span>
                            </div>
                            <div>
                                <div class="fw-semibold mb-1">Cảm ơn bạn đã đánh giá</div>
                                <div style="letter-spacing:2px;">
                                    {{#each stars}}
                                        {{#if (lte this ../userRating.rate)}}
                                            <span class="text-warning" style="font-size:1.2rem;">★</span>
                                        {{else}}
                                            <span class="text-secondary" style="font-size:1.2rem;">★</span>
                                        {{/if}}
                                    {{/each}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{else}}
                <div class="col-auto mb-3 d-flex align-items-stretch">
                    <form id="ratingForm" class="card flex-fill" style="min-width:220px; width:auto;">
                        <div class="card-body d-flex flex-row align-items-center gap-3">
                            <span class="me-2 text-nowrap">Đánh giá của bạn:</span>
                            <div class="rating-stars" style="font-size:1.7rem;">
                                {{#each stars}}
                                <input type="radio" class="d-none" name="rating" id="star{{this}}" value="{{this}}">
                                <label for="star{{this}}" class="star-label" style="cursor:pointer; color:#ccc; margin:0 2px;">★</label>
                                {{/each}}
                            </div>
                            <button type="submit" class="btn btn-warning ms-3">Gửi đánh giá</button>
                        </div>
                    </form>
                </div>
                {{/if}}
            {{/if}}


            <!-- Form bình -->
            <div class="col mb-3 d-flex align-items-stretch">
                <form id="commentForm" class="card flex-fill w-100">
                    <div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-3">
                        <div class="flex-grow-1">
                            <input type="text" name="comment" class="form-control" rows="1"
                                placeholder="Nhập bình luận...">
                        </div>
                        <button type="submit" class="btn btn-primary">Gửi bình luận</button>
                    </div>
                </form>
            </div>
        </div>


        <!-- Danh sách bình luận -->
        <div class="row g-4 align-items-start">
            <div class="col-12">
                <div id="commentsList" class="d-flex flex-column gap-3">
                    {{#if comments.length}}
                    {{#each comments}}
                    <div class="p-3 border rounded bg-light">
                        <div class="d-flex justify-content-between mb-1">
                            <strong>{{#if name}}{{name}}{{else}}Người dùng ẩn danh{{/if}}</strong>
                            <span class="text-muted small">
                                {{#if date}}
                                {{date}}
                                {{/if}}
                            </span>
                        </div>
                        <div>{{content}}</div>
                    </div>
                    {{/each}}
                    <!-- Phân trang -->
                    <nav class="mt-3 d-flex justify-content-center">
                        <ul class="pagination mb-0">
                            {{#if hasPrevPage}}
                            <li class="page-item">
                                <a class="page-link" href="?page={{prevPage}}">Trước</a>
                            </li>
                            {{/if}}
                            {{#each pages}}
                            <li class="page-item {{#if active}}active{{/if}}">
                                <a class="page-link" href="?page={{this}}">{{this}}</a>
                            </li>
                            {{/each}}
                            {{#if hasNextPage}}
                            <li class="page-item">
                                <a class="page-link" href="?page={{nextPage}}">Tiếp</a>
                            </li>
                            {{/if}}
                        </ul>
                    </nav>
                    {{else}}
                    <div class="text-muted small">Chưa có bình luận.</div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Xử lý đánh giá sao
    document.querySelectorAll('.rating-stars').forEach(function (starsGroup) {
        const stars = starsGroup.querySelectorAll('input[type="radio"]');
        const labels = starsGroup.querySelectorAll('.star-label');
        stars.forEach((star, idx) => {
            star.addEventListener('change', function () {
                labels.forEach((label, i) => {
                    label.style.color = (i < idx + 1) ? '#ffc107' : '#ccc';
                });
            });
        });
        labels.forEach((label, idx) => {
            label.addEventListener('mouseenter', function () {
                labels.forEach((l, i) => {
                    l.style.color = (i <= idx) ? '#ffc107' : '#ccc';
                });
            });
            label.addEventListener('mouseleave', function () {
                const checked = starsGroup.querySelector('input[type="radio"]:checked');
                let checkedIdx = -1;
                stars.forEach((star, i) => {
                    if (star.checked) checkedIdx = i;
                });
                labels.forEach((l, i) => {
                    l.style.color = (i <= checkedIdx) ? '#ffc107' : '#ccc';
                });
            });
            label.addEventListener('click', function () {
                stars[idx].checked = true;
                labels.forEach((l, i) => {
                    l.style.color = (i <= idx) ? '#ffc107' : '#ccc';
                });
            });
        });
    });

    // Xử lý chọn cấu hình
    (function () {
        const priceEl = document.getElementById('productPrice');
        const stockEl = document.getElementById('productStock');
        const qtyInput = document.getElementById('qtyInput');
        const minus = document.getElementById('qtyMinus');
        const plus = document.getElementById('qtyPlus');
        const variantBtns = document.querySelectorAll('.variant-btn');
        let selectedVariantId = null;
        let selectedVariantStock = 0;

        function clampQty() {
            if (!qtyInput) return;
            let val = parseInt(qtyInput.value || '1', 10);
            if (isNaN(val)) val = 1;
            if (selectedVariantStock > 0) {
                if (val < 1) val = 1;
                if (val > selectedVariantStock) val = selectedVariantStock;
            } else {
                val = 0;
            }
            qtyInput.value = String(val);
            if (plus) plus.disabled = (selectedVariantStock === 0) || (val >= selectedVariantStock);
            if (minus) minus.disabled = (selectedVariantStock === 0) || (val <= 1);
            if (qtyInput) qtyInput.max = selectedVariantStock > 0 ? String(selectedVariantStock) : '';
        }

        if (variantBtns.length) {
            const first = variantBtns[0];
            selectedVariantId = first.getAttribute('data-variant-id');
            selectedVariantStock = Number(first.dataset.stock || 0);
            clampQty();
        }

        variantBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();

                variantBtns.forEach(b => {
                    b.classList.remove('btn-primary', 'text-white');
                    b.classList.add('btn-outline-primary');
                });

                btn.classList.remove('btn-outline-primary');
                btn.classList.add('btn-primary', 'text-white');

                const price = Number(btn.dataset.price || 0);
                const stock = Number(btn.dataset.stock || 0);
                selectedVariantId = btn.getAttribute('data-variant-id');
                selectedVariantStock = stock;

                if (!isNaN(price)) {
                    priceEl.textContent = price.toLocaleString('vi-VN') + ' VNĐ';
                }
                if (!isNaN(stock)) {
                    stockEl.textContent = stock + ' sản phẩm';
                }
                clampQty();
            });
        });

        // Xử lý số lượng
        if (qtyInput && minus && plus) {
            minus.addEventListener('click', (e) => {
                e.preventDefault();
                const current = Number(qtyInput.value) || 1;
                const n = Math.max(1, current - 1);
                qtyInput.value = String(n);
                clampQty();
            });

            plus.addEventListener('click', (e) => {
                e.preventDefault();
                const current = Number(qtyInput.value) || 1;
                let n = current + 1;
                if (selectedVariantStock > 0 && n > selectedVariantStock) {
                    n = selectedVariantStock;
                }
                qtyInput.value = String(n);
                clampQty();
            });

            qtyInput.addEventListener('input', () => {
                clampQty();
            });
            qtyInput.addEventListener('change', () => {
                clampQty();
            });
        }

        // Thêm vào giỏ -> gọi API không submit form
        const addBtn = document.getElementById('addToCartBtn');
        const form = document.getElementById('addToCartForm');
        const formVariantInput = document.getElementById('formVariantId');
        const formQuantityInput = document.getElementById('formQuantity');

        if (addBtn && form && formVariantInput && formQuantityInput) {
            addBtn.addEventListener('click', async () => {
                clampQty();
                const variantId = selectedVariantId;
                const quantity = Number(qtyInput.value) || 1;
                
                if (!variantId) {
                    alert('Vui lòng chọn cấu hình sản phẩm');
                    return;
                }

                addBtn.disabled = true;
                const originalText = addBtn.textContent;
                addBtn.textContent = 'Đang thêm...';

                try {
                    const resp = await fetch('/api/users/cart/me', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ variantId, quantity })
                    });

                    if (resp.ok) {
                        addBtn.textContent = '✓ Đã thêm';
                        addBtn.classList.remove('btn-outline-primary');
                        addBtn.classList.add('btn-success');
                        
                        // Cập nhật số lượng giỏ hàng trong header
                        updateCartBadge();
                        
                        // Reset sau 2 giây
                        setTimeout(() => {
                            addBtn.textContent = originalText;
                            addBtn.classList.remove('btn-success');
                            addBtn.classList.add('btn-outline-primary');
                            addBtn.disabled = false;
                        }, 2000);
                    } else {
                        throw new Error('Lỗi khi thêm vào giỏ hàng');
                    }
                } catch (error) {
                    alert('Không thể thêm vào giỏ hàng. Vui lòng thử lại.');
                    addBtn.textContent = originalText;
                    addBtn.disabled = false;
                }
            });
        }

        // Đặt hàng ngay -> chuyển thẳng sang checkout với món hàng hiện tại
        const orderNowBtn = document.getElementById('orderNowBtn');
        if (orderNowBtn) {
            orderNowBtn.addEventListener('click', (e) => {
                e.preventDefault();
                clampQty();

                const selectedBtn = document.querySelector('.variant-btn.btn-primary');
                if (!selectedBtn) {
                    alert('Vui lòng chọn cấu hình sản phẩm');
                    return;
                }
                const variantId = selectedBtn.getAttribute('data-variant-id');
                const price = Number(selectedBtn.dataset.price || 0);
                const distinctFeature = selectedBtn.dataset.feature || '';
                const qty = Math.max(1, Number(qtyInput?.value || '1'));

                // Lấy tên sản phẩm từ DOM để tránh lỗi escape chuỗi
                const nameEl = document.querySelector('h2.fw-bold');
                const productName = (nameEl?.textContent || '').trim() || 'Sản phẩm';

                if (!variantId) {
                    alert('Vui lòng chọn cấu hình sản phẩm');
                    return;
                }

                // Đóng gói item theo định dạng checkout đang dùng
                const item = {
                    variantId: variantId,
                    productName: productName,
                    distinctFeature: distinctFeature,
                    quantity: qty,
                    price: price
                };

                try {
                    sessionStorage.setItem('checkoutItems', JSON.stringify([item]));
                } catch {}

                window.location.href = '/checkout';
            });
        }

        // Hàm cập nhật số lượng giỏ hàng
        async function updateCartBadge() {
            try {
                const resp = await fetch('/api/users/cart/me', { credentials: 'include' });
                if (resp.ok) {
                    const data = await resp.json();
                    const totalItems = data?.data?.totalProduct || data?.totalProduct || 0;
                    const badge = document.querySelector('.btn-cart .badge');
                    if (badge) {
                        badge.textContent = totalItems;
                    }
                }
            } catch (e) {
                console.error('Không thể cập nhật số lượng giỏ hàng:', e);
            }
        }

        // Xử lý click thumbnail đổi ảnh lớn
        const mainImage = document.getElementById('mainImage');
        const thumbButtons = document.querySelectorAll('.thumb-btn');
        if (mainImage && thumbButtons.length) {
            thumbButtons.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const img = btn.querySelector('img');
                    if (!img) return;
                    const src = img.getAttribute('src');
                    if (src) {
                        mainImage.setAttribute('src', src);
                    }
                    // Highlight active thumbnail
                    thumbButtons.forEach(b => {
                        b.style.outline = 'none';
                        b.style.boxShadow = 'none';
                        b.classList.remove('active-thumb');
                    });
                    btn.classList.add('active-thumb');
                    btn.style.outline = '2px solid #0d6efd';
                    btn.style.boxShadow = '0 0 4px rgba(13,110,253,.7)';
                });
            });
        }
    })();
</script>


<script src="/socket.io/socket.io.js"></script>
<script src="/js/socket_server.js"></script>
<script>
    (function(){
        const productId = '{{product._id}}';
        const commentsList = document.getElementById('commentsList');
        const commentForm = document.getElementById('commentForm');
        const ratingDisplayBox = document.querySelector('.display-5.fw-bold');
        const starLabelsGroups = document.querySelectorAll('.rating-stars');
        const isLoggedIn = {{#if isLoggedIn}}true{{else}}false{{/if}};

        // ratingForm accessor and attach helpers
        const getRatingForm = () => document.getElementById('ratingForm');
        function attachRatingFormHandler(){
            const ratingForm = getRatingForm();
            if(!ratingForm) return;
            if (ratingForm._attached) return;
            ratingForm._attached = true;
            ratingForm.addEventListener('submit', async (e)=>{
                e.preventDefault();
                const checked = ratingForm.querySelector('input[name="rating"]:checked');
                if(!checked){ return; }
                const rateVal = Number(checked.value);
                const btn = ratingForm.querySelector('button[type="submit"]');
                if(btn) btn.disabled = true;
                try {
                    const resp = await fetch('/api/ratings', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ productId, rate: rateVal })
                    });
                    if(resp.ok){
                        // reload or update UI after successful rate
                        // prefer reload to get consistent server-side state (comments/ratings)
                        location.reload();
                    } else if (resp.status === 401) {
                        alert('Vui lòng đăng nhập để đánh giá.');
                    } else {
                        const err = await resp.json().catch(()=>null);
                        alert(err?.message || 'Không thể gửi đánh giá');
                    }
                } catch (err) {
                    console.error('Rate submit failed', err);
                    alert('Lỗi khi gửi đánh giá');
                } finally { if(btn) btn.disabled=false; }
            });
        }

        // Không hỗ trợ xóa đánh giá từ giao diện

        function formatDate(d){
            try { return new Date(d).toLocaleString('vi-VN'); } catch { return d || ''; }
        }

        function recolorStars(newAvg){
            starLabelsGroups.forEach(group => {
                const labels = group.querySelectorAll('.star-label');
                labels.forEach((l,i)=>{ l.style.color = (i < Math.round(newAvg)) ? '#ffc107' : '#ccc'; });
            });
        }

        function onNewComment(comment){
            if(!commentsList) return;
            const wrapper = document.createElement('div');
            wrapper.className = 'p-3 border rounded bg-light';
            wrapper.innerHTML = `
                <div class="d-flex justify-content-between mb-1">
                    <strong>${comment.fullName || comment.userName || 'Người dùng'}</strong>
                    <span class="text-muted small">${formatDate(comment.createdAt || comment.date)}</span>
                </div>
                <div>${comment.content}</div>
            `;
            commentsList.prepend(wrapper);
        }

        function onNewRating(rating){
            const avg = rating.averageRate || rating.newAverage || rating.rate || null;
            if(avg !== null && ratingDisplayBox){
                ratingDisplayBox.textContent = avg.toFixed(1).replace(/\.0$/,'');
                recolorStars(avg);
            }
        }


        if(window.joinProductRoom && productId){
            joinProductRoom(productId, onNewComment, onNewRating);
        }

        if(commentForm){
            commentForm.addEventListener('submit', async (e)=>{
                e.preventDefault();
                const input = commentForm.querySelector('input[name="comment"]');
                const content = (input?.value || '').trim();
                if(!content){ return; }
                input.disabled = true;
                try {
                    const resp = await fetch('/api/comments', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ productId, content })
                    });
                    if(resp.ok){ input.value=''; }
                } catch {} finally { input.disabled = false; }
            });
        }

        // Attach rating handler to existing DOM (if server rendered it)
        attachRatingFormHandler();

        // If user is logged in, ask backend whether this user already rated this product
        if(isLoggedIn && productId){
            (async ()=>{
                try{
                    const resp = await fetch(`/api/ratings/me/${productId}`, { credentials: 'include' });
                    if(!resp.ok) {
                        return;
                    }
                    const json = await resp.json();
                    const myRate = json?.data || null;
                    if(myRate){
                        // If server didn't render userRating block (no element), replace ratingForm with display
                        const rf = getRatingForm();
                        if(rf){
                            // helper to render stars (5 total)
                            const renderStars = (count)=>{
                                const total = 5; const n = Math.max(0, Math.min(total, Number(count)||0));
                                let html = '';
                                for(let i=0;i<total;i++){
                                    const filled = i < n;
                                    html += `<span class="${filled? 'text-warning':'text-secondary'}" style="font-size:1.2rem;">★</span>`;
                                }
                                return html;
                            };
                            const wrapper = document.createElement('div');
                            wrapper.className = 'col-auto mb-3 d-flex align-items-stretch';
                            wrapper.innerHTML = `
                                <div class="card flex-fill p-3" style="min-width:260px; width:auto;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:44px; height:44px; background:#fff7e6; border:1px solid #ffe8b0;">
                                            <span class="text-warning" style="font-size:1.2rem;">★</span>
                                        </div>
                                        <div>
                                            <div class="fw-semibold mb-1">Cảm ơn bạn đã đánh giá</div>
                                            <div style="letter-spacing:2px;">${renderStars(myRate.rate)}</div>
                                        </div>
                                    </div>
                                </div>
                            `;
                            rf.parentNode.replaceChild(wrapper, rf);
                        }
                    } else {
                        // not rated: ensure rating form exists and attach handler
                        attachRatingFormHandler();
                    }
                } catch(e){
                    console.warn('Failed to fetch user rating', e);
                }
            })();
        }
    })();
</script>