<div class="container py-4 product-page">
    <div class="row g-4 align-items-stretch">
        <!-- Images -->
        <div class="col-lg-6 h-100">
            <div class="ratio ratio-4x3 border rounded mb-3 bg-white d-flex align-items-center justify-content-center">
                <img id="mainImage" src="{{product.images.[0]}}" alt="{{product.name}}"
                    class="w-100 h-100 object-fit-contain p-2"
                    onerror="this.onerror=null;this.src='https://placehold.co/600x400?text={{product.name}}';">
            </div>
            <div class="d-flex justify-content-between mt-3" style="width: 100%;">
                {{#each product.images}}
                <button type="button" class="p-0 border rounded thumb-btn"
                    style="width: 100px; height: 100px; overflow: hidden; background: #fff;">
                    <img src="{{this}}" alt="{{../product.name}}" class="w-100 h-100 object-fit-cover"
                        onerror="this.onerror=null;this.src='https://placehold.co/100x100?text=No+Img';">
                </button>
                {{/each}}
            </div>
        </div>

        <!-- Info -->
        <div class="col-lg-6 d-flex flex-column h-100 info-col">
            <div class="top-info">
                <h2 class="fw-bold mb-3 text-primary">{{product.name}}</h2>
                <div class="mb-3">
                    <span class="text-muted">Thương hiệu:</span>
                    <strong class="ms-2">{{brand.name}}</strong>
                </div>
                <div class="mb-3">
                    <span class="text-muted">Danh mục:</span>
                    <strong class="ms-2">{{category.name}}</strong>
                </div>
                <div class="desc-scroll mb-3" style="max-height: 120px; overflow-y: auto;">
                    <span class="text-muted">Mô tả:</span>
                    <div class="mt-2">{{product.description}}</div>
                </div>
            </div>

            <!-- Variants -->
            <div class="mb-3">
                <span class="text-muted">Cấu hình:</span>
                <div class="btn-group-vertical w-100 mt-2" role="group" aria-label="Chọn cấu hình">
                    {{#each product.variants}}
                    <button type="button"
                        class="variant-btn btn mb-2 {{#if @first}}btn-primary text-white{{else}}btn-outline-primary{{/if}}"
                        data-price="{{this.price}}" data-feature="{{this.distinctFeature}}" data-stock="{{this.stock}}"
                        style="text-align:left; padding: 12px 16px;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-cpu me-2"></i>{{this.distinctFeature}}
                            </div>
                            <div class="fw-bold text-end">
                                {{formatPrice this.price}} VNĐ
                            </div>
                        </div>
                        <small class="text-muted d-block mt-1">Còn lại: {{this.stock}} sản phẩm</small>
                    </button>
                    {{/each}}
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Giá:</span>
                    <span id="productPrice" class="fs-4 fw-bold text-danger">
                        {{#if selectedVariant}}{{formatPrice selectedVariant.price}} VNĐ{{else}}{{formatPrice
                        product.variants.[0].price}} VNĐ{{/if}}
                    </span>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="text-muted">Kho:</span>
                    <span id="productStock" class="fw-bold">
                        {{#if selectedVariant}}{{selectedVariant.stock}}{{else}}{{product.variants.[0].stock}}{{/if}}
                        sản phẩm
                    </span>
                </div>
            </div>

            <div class="d-flex gap-3 mb-4">
                <button class="btn btn-success px-4">Đặt hàng</button>
                <button class="btn btn-outline-primary px-4">Thêm vào giỏ</button>
            </div>
        </div>
    </div>



    <!-- Rating & Comment Section -->
    <div class="mt-5">
        <h4 class="fw-bold mb-3">Đánh giá & Bình luận</h4>

        <!-- Trung bình rating sản phẩm -->
        <div class="row mb-3">
            <div class="col-auto">
                <div class="d-flex align-items-center gap-3 bg-white border rounded p-3 shadow-sm">
                    <div class="display-5 fw-bold mb-0 text-primary text-center" style="min-width:60px; width:80px;">
                        {{product.rate}}
                    </div>
                    <div>
                        <div style="letter-spacing:2px;">
                            {{#each ../stars}}
                            {{#if (lte this ../../product.rate)}}
                            <span class="text-warning" style="font-size:1.7rem;">★</span>
                            {{else}}
                            <span class="text-secondary" style="font-size:1.7rem;">★</span>
                            {{/if}}
                            {{/each}}
                        </div>
                        <div class="text-muted small">Đánh giá trung bình</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 d-flex align-items-stretch">
            {{#if verify}}
            <div class="col-auto mb-3 d-flex align-items-stretch">
                <form id="ratingForm" class="card flex-fill" style="min-width:220px; width:auto;">
                    <div class="card-body d-flex flex-row align-items-center gap-3">
                        <span class="me-2 text-nowrap">Đánh giá của bạn:</span>
                        <div class="rating-stars" style="font-size:1.7rem;">
                            {{#each ../stars}}
                            <input type="radio" class="d-none" name="rating" id="star{{this}}" value="{{this}}">
                            <label for="star{{this}}" class="star-label"
                                style="cursor:pointer; color:#ccc; margin:0 2px;">★</label>
                            {{/each}}
                        </div>
                        <button type="submit" class="btn btn-warning ms-3">Gửi đánh giá</button>
                    </div>
                </form>
            </div>
            {{/if}}

            <!-- Form bình luận chiếm phần còn lại -->
            <div class="col mb-3 d-flex align-items-stretch">
                <form id="commentForm" class="card flex-fill w-100">
                    <div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-3">
                        <div class="flex-grow-1">
                            <input type="text" name="comment" class="form-control" rows="1"
                                placeholder="Nhập bình luận...">
                        </div>
                        <button type="submit" class="btn btn-primary">Gửi bình luận</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-4 align-items-start">
            <!-- Danh sách bình luận -->
            <div class="col-12">
                <div id="commentsList" class="d-flex flex-column gap-3">
                    {{#if comments.length}}
                    {{#each comments}}
                    <div class="p-3 border rounded bg-light">
                        <div class="d-flex justify-content-between mb-1">
                            <strong>{{#if name}}{{name}}{{else}}Người dùng ẩn danh{{/if}}</strong>
                            <span class="text-muted small">
                                {{#if date}}
                                {{date}}
                                {{/if}}
                            </span>
                        </div>
                        <div>{{content}}</div>
                    </div>
                    {{/each}}
                    <!-- Phân trang -->
                    <nav class="mt-3 d-flex justify-content-center">
                        <ul class="pagination mb-0">
                            {{#if hasPrevPage}}
                            <li class="page-item">
                                <a class="page-link" href="?page={{prevPage}}">Trước</a>
                            </li>
                            {{/if}}
                            {{#each pages}}
                            <li class="page-item {{#if active}}active{{/if}}">
                                <a class="page-link" href="?page={{this}}">{{this}}</a>
                            </li>
                            {{/each}}
                            {{#if hasNextPage}}
                            <li class="page-item">
                                <a class="page-link" href="?page={{nextPage}}">Tiếp</a>
                            </li>
                            {{/if}}
                        </ul>
                    </nav>
                    {{else}}
                    <div class="text-muted small">Chưa có bình luận.</div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('.rating-stars').forEach(function (starsGroup) {
            const stars = starsGroup.querySelectorAll('input[type="radio"]');
            const labels = starsGroup.querySelectorAll('.star-label');
            stars.forEach((star, idx) => {
                star.addEventListener('change', function () {
                    labels.forEach((label, i) => {
                        label.style.color = (i < idx + 1) ? '#ffc107' : '#ccc';
                    });
                });
            });
            labels.forEach((label, idx) => {
                label.addEventListener('mouseenter', function () {
                    labels.forEach((l, i) => {
                        l.style.color = (i <= idx) ? '#ffc107' : '#ccc';
                    });
                });
                label.addEventListener('mouseleave', function () {
                    const checked = starsGroup.querySelector('input[type="radio"]:checked');
                    let checkedIdx = -1;
                    stars.forEach((star, i) => {
                        if (star.checked) checkedIdx = i;
                    });
                    labels.forEach((l, i) => {
                        l.style.color = (i <= checkedIdx) ? '#ffc107' : '#ccc';
                    });
                });
                label.addEventListener('click', function () {
                    stars[idx].checked = true;
                    labels.forEach((l, i) => {
                        l.style.color = (i <= idx) ? '#ffc107' : '#ccc';
                    });
                });
            });
        });

        (function () {
            // Xử lý ảnh thumbnail
            const mainImg = document.getElementById('mainImage');
            document.querySelectorAll('.thumb-btn img').forEach(img => {
                img.parentElement.addEventListener('click', () => {
                    mainImg.src = img.src;
                    document.querySelectorAll('.thumb-btn').forEach(b => b.classList.remove('border-primary'));
                    img.parentElement.classList.add('border-primary');
                });
            });

            // Xử lý variant selection
            const priceEl = document.getElementById('productPrice');
            const stockEl = document.getElementById('productStock');
            const variantBtns = document.querySelectorAll('.variant-btn');

            variantBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();

                    // Xóa active state từ tất cả buttons
                    variantBtns.forEach(b => {
                        b.classList.remove('btn-primary', 'text-white');
                        b.classList.add('btn-outline-primary');
                    });

                    // Thêm active state cho button được chọn
                    btn.classList.remove('btn-outline-primary');
                    btn.classList.add('btn-primary', 'text-white');

                    // Cập nhật giá và số lượng kho
                    const price = Number(btn.dataset.price || 0);
                    const stock = Number(btn.dataset.stock || 0);
                    const feature = btn.dataset.feature || '';

                    if (!isNaN(price)) {
                        priceEl.textContent = price.toLocaleString('vi-VN') + ' VNĐ';
                    }

                    if (!isNaN(stock)) {
                        stockEl.textContent = stock + ' sản phẩm';
                    }

                    console.log('Variant selected:', { feature, price, stock });
                });
            });
        })();
    </script>