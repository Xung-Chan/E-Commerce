<div class="container-fluid flex-grow-1 p-0">
    <div class="row g-0">
        <!-- Sidebar lọc sản phẩm -->
        <aside class="col-md-3 px-0">
            <div class="filter-area bg-light h-100 border-end ps-3"
                style="min-height: 100vh; padding: 32px 16px 32px 0;">
                <div class="container py-4">
                    <div class="card mb-4 shadow-sm border-0">
                        <div class="card-body py-4">
                            <h5 class="card-title fw-bold text-primary mb-2 text-center">Danh mục sản phẩm</h5>
                            <p class="card-text text-muted mb-3 text-center">
                                Chọn danh mục để lọc sản phẩm phù hợp với nhu cầu của bạn.
                            </p>
                            <form id="filterForm" method="GET" action="/catalog">
                                {{#if query.sortBy}}<input type="hidden" name="sortBy" value="{{query.sortBy}}">{{/if}}
                                {{#if query.sortOrder}}<input type="hidden" name="sortOrder"
                                    value="{{query.sortOrder}}">{{/if}}
                                <hr>


                                {{!-- Tìm theo Category --}}
                                <h6 class="fw-semibold text-uppercase small text-secondary mb-2">Tìm theo Category</h6>
                                <div class="row row-cols-2 gx-3">
                                    {{#each categories}}
                                    <div class="col mb-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="categoryId"
                                                id="cat-{{@index}}" value="{{_id}}" {{#if (eq ../query.categoryId
                                                _id)}}checked{{/if}}>
                                            <label class="form-check-label" for="cat-{{@index}}">{{name}}</label>
                                        </div>
                                    </div>
                                    {{/each}}
                                </div>


                                {{!-- Theo khoảng giá --}}
                                <h6 class="fw-semibold text-uppercase small text-secondary mt-3 mb-2">Theo khoảng giá
                                </h6>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="text" class="form-control form-control-sm price-input" name="minPrice"
                                        inputmode="numeric" placeholder="Từ" value="{{query.minPrice}}">
                                    <span class="text-muted">-</span>
                                    <input type="text" class="form-control form-control-sm price-input" name="maxPrice"
                                        inputmode="numeric" placeholder="Đến" value="{{query.maxPrice}}">
                                </div>


                                {{!-- Theo đánh giá --}}    
                                <h6 class="fw-semibold text-uppercase small text-secondary mt-3 mb-2">Theo đánh giá</h6>
                                <div class="row row-cols-2 gx-3">
                                    <div class="col mb-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="rating" id="rating-3"
                                                value="3" {{#if (eq query.rating "3" )}}checked{{/if}}>
                                            <label class="form-check-label" for="rating-3">≥ 3 sao</label>
                                        </div>
                                    </div>
                                    <div class="col mb-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="rating" id="rating-4"
                                                value="4" {{#if (eq query.rating "4" )}}checked{{/if}}>
                                            <label class="form-check-label" for="rating-4">≥ 4 sao</label>
                                        </div>
                                    </div>
                                    <div class="col mb-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="rating" id="rating-5"
                                                value="5" {{#if (eq query.rating "5" )}}checked{{/if}}>
                                            <label class="form-check-label" for="rating-5">5 sao</label>
                                        </div>
                                    </div>
                                </div>

                                {{!-- Nút lọc và bỏ lọc --}}
                                <div class="d-flex gap-2 justify-content-center pt-5">
                                    <button type="submit" class="btn btn-primary mt-3 w-100">Lọc</button>
                                    <a href="/catalog" class="btn btn-outline-secondary mt-3 w-100">Bỏ lọc</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
        </aside>

        <!-- Danh sách sản phẩm -->
        <main class="col-md-9 d-flex flex-column" style="min-height: 80vh;">
            <!-- Thanh sắp xếp -->
            <form method="GET" class="mb-3" id="sortForm">
                {{#if query.categoryId}}<input type="hidden" name="categoryId" value="{{query.categoryId}}">{{/if}}
                {{#if query.minPrice}}<input type="hidden" name="minPrice" value="{{query.minPrice}}">{{/if}}
                {{#if query.maxPrice}}<input type="hidden" name="maxPrice" value="{{query.maxPrice}}">{{/if}}
                {{#if query.rating}}<input type="hidden" name="rating" value="{{query.rating}}">{{/if}}
                
                <input type="hidden" name="sortBy" id="sortByHidden" value="{{query.sortBy}}">
                <input type="hidden" name="sortOrder" id="sortOrderHidden" value="{{query.sortOrder}}">
                
                <div class="d-flex flex-wrap align-items-center gap-2 p-3 bg-light rounded shadow-sm">
                    <span class="fw-semibold text-primary"><i class="bi bi-funnel me-1"></i>Sắp xếp:</span>
                    <select class="form-select form-select-sm w-auto" id="sortPreset">
                        <option value="maxPrice-desc" {{#if (eq query.sortBy "maxPrice")}}{{#if (eq query.sortOrder "desc")}}selected{{/if}}{{/if}}>Giá cao nhất</option>
                        <option value="minPrice-asc" {{#if (eq query.sortBy "minPrice")}}{{#if (eq query.sortOrder "asc")}}selected{{/if}}{{/if}}>Giá thấp nhất</option>
                        <option value="name-asc" {{#if (eq query.sortBy "name")}}{{#if (eq query.sortOrder "asc")}}selected{{/if}}{{/if}}>Tên A-Z</option>
                        <option value="name-desc" {{#if (eq query.sortBy "name")}}{{#if (eq query.sortOrder "desc")}}selected{{/if}}{{/if}}>Tên Z-A</option>
                        <option value="createdAt-desc" {{#if (eq query.sortBy "createdAt")}}{{#if (eq query.sortOrder "desc")}}selected{{/if}}{{/if}}>Mới nhất</option>
                        <option value="createdAt-asc" {{#if (eq query.sortBy "createdAt")}}{{#if (eq query.sortOrder "asc")}}selected{{/if}}{{/if}}>Cũ nhất</option>
                    </select>

                    <button class="btn btn-sm btn-primary d-flex align-items-center gap-1" type="submit">
                        <i class="bi bi-arrow-down-up"></i> Áp dụng
                    </button>
                </div>
            </form>


            <!-- Lưới sản phẩm -->
            <div class="flex-grow-1 px-4 py-3">
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    {{#if products_catalog.length}}
                    {{#each products_catalog}}
                    <div class="col">
                        <div class="card h-100 shadow-sm d-flex flex-column">
                            <a href="/product/{{_id}}" class="text-decoration-none">
                                <img src="{{images.[0]}}" class="card-img-top" alt="{{name}}"
                                    style="height:320px;object-fit:cover;"
                                    onerror="this.onerror=null;this.src='https://placehold.co/600x400?text={{name}}';">
                                <div class="card-body p-2 d-flex flex-column h-100">
                                    <h6 class="card-title fw-bold text-primary mb-0"
                                        style="font-size:1.2rem; min-height:3rem;">
                                        <a href="/product/{{_id}}"
                                            class="text-decoration-none text-primary">{{name}}</a>
                                    </h6>
                                    <div class="small text-muted mb-1">{{description}}</div>
                                    <div class="small text-dark mb-3">
                                        {{variants.[0].diffTitle}}
                                    </div>
                                    <div class="fw-bold text-danger mt-auto" style="font-size:1rem;">
                                        {{#if (eq minPrice maxPrice)}}
                                        {{formatPrice minPrice}} VNĐ
                                        {{else}}
                                        {{formatPrice minPrice}} - {{formatPrice maxPrice}} VNĐ
                                        {{/if}}
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                    {{/each}}
                    {{else}}
                    <div class="col-12 text-center py-5">
                        <span class="text-muted">Không có sản phẩm phù hợp với bộ lọc.</span>
                    </div>
                    {{/if}}
                </div>
            </div>


            <!-- Phân trang -->
            <nav class="mt-4 d-flex justify-content-center">
                <ul class="pagination">
                    <li class="page-item {{#if isFirstPage}}disabled{{/if}}">
                        <a class="page-link"
                            href="?page={{prevPage}}{{#if baseQueryString}}&{{baseQueryString}}{{/if}}">Trước</a>
                    </li>
                    {{#each pages}}
                    <li class="page-item {{#if active}}active{{/if}}">
                        <a class="page-link"
                            href="?page={{number}}{{#if ../baseQueryString}}&{{../baseQueryString}}{{/if}}">{{number}}</a>
                    </li>
                    {{/each}}
                    <li class="page-item {{#if isLastPage}}disabled{{/if}}">
                        <a class="page-link"
                            href="?page={{nextPage}}{{#if baseQueryString}}&{{baseQueryString}}{{/if}}">Tiếp</a>
                    </li>
                </ul>
            </nav>
        </main>
    </div>
</div>


<script>
    document.addEventListener('DOMContentLoaded', () => {
        const f = document.getElementById('filterForm');
        if (!f) return;

        // Hàm lấy chuỗi chỉ gồm chữ số
        function rawDigits(v) { return (v || '').replace(/\D/g, ''); }
        
        // Hàm định dạng với dấu chấm ngăn cách hàng nghìn
        function formatDots(v) { return v.replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
       
        // Xử lý định dạng ô nhập giá
        const priceInputs = f.querySelectorAll('.price-input');
        priceInputs.forEach(inp => {
            const raw = rawDigits(inp.value);
            inp.value = raw ? formatDots(raw) : '';
            
            // Sự kiện nhập liệu
            inp.addEventListener('input', () => {
                const caretEnd = inp.selectionEnd;
                const rawVal = rawDigits(inp.value);
                inp.value = rawVal ? formatDots(rawVal) : '';
                inp.setSelectionRange(inp.value.length, inp.value.length);
            });
            
            // Sự kiện mất focus
            inp.addEventListener('blur', () => {
                const rawVal = rawDigits(inp.value);
                inp.value = rawVal ? formatDots(rawVal) : '';
            });
        });
        

        // Xử lý trước khi submit form lọc
        f.addEventListener('submit', () => {
            ['minPrice', 'maxPrice'].forEach(name => {
                const el = f.querySelector(`[name="${name}"]`);
                if (!el) return;
                const raw = rawDigits(el.value);
                if (!raw) { el.disabled = true; }
                else { el.value = raw; }
            });
        });
        

        // Xử lý thay đổi sắp xếp
        const sortPreset = document.getElementById('sortPreset');
        const sortByHidden = document.getElementById('sortByHidden');
        const sortOrderHidden = document.getElementById('sortOrderHidden');
        if (sortPreset && sortByHidden && sortOrderHidden) {
            sortPreset.addEventListener('change', () => {
                const val = sortPreset.value;
                const [field, order] = val.split('-');
                sortByHidden.value = field;
                sortOrderHidden.value = order;
            });
        }
    });
</script>