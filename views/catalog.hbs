                                        <input class="form-check-input component-checkbox" type="checkbox"
                                            id="psu-750-c" name="psu" value="Nguồn 750W">
                                        <label class="form-check-label" for="psu-750-c">Nguồn 750W</label>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input component-checkbox" type="checkbox"
                                            id="psu-850-c" name="psu" value="Nguồn 850W">
                                        <label class="form-check-label" for="psu-850-c">Nguồn 850W</label>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input component-checkbox" type="checkbox"
                                            id="psu-1000-c" name="psu" value="Nguồn trên 1000W">
                                        <label class="form-check-label" for="psu-1000-c">Nguồn trên 1000W</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-primary w-100" type="submit">Áp dụng bộ lọc</button>
                    </div>
                </form>
            </div>
        </aside>

        <!-- Danh sách sản phẩm -->
        <main class="col-md-9 d-flex flex-column" style="min-height: 80vh;">
            <div class="flex-grow-1 px-4 py-3">
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    {{#if products_catalog.length}}
                    {{#each products_catalog}}
                    <div class="col">
                        <div class="card h-100 shadow-sm d-flex flex-column">
                            <a href="{{link}}" class="text-decoration-none">
                                <img src="{{images.[0]}}" class="card-img-top" alt="{{name}}"
                                    onerror="this.onerror=null;this.src='https://placehold.co/600x400?text={{name}}';">
                                <div class="card-body p-2 d-flex flex-column h-100">
                                    <h6 class="card-title fw-bold text-primary mb-1" style="font-size:1.2rem;">
                                        <a href="{{link}}" class="text-decoration-none text-primary">{{name}}</a>
                                    </h6>
                                    <div class="small text-muted mb-1">{{description}}</div>
                                    <div class="small text-dark mb-1">
                                        {{#if variants}}
                                        {{variants.[0].diffTitle}}
                                        {{else if spec}}
                                        {{spec}}
                                        {{/if}}
                                    </div>
                                    <div class="fw-bold text-danger mt-auto" style="font-size:1rem;">
                                        {{#if variants}}
                                        {{formatPrice variants.[0].price}} VNĐ
                                        {{else}}
                                        {{formatPrice price}} VNĐ
                                        {{/if}}
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                    {{/each}}
                    {{else}}
                    <div class="col-12 text-center py-5">
                        <span class="text-muted">Không có sản phẩm phù hợp với bộ lọc.</span>
                    </div>
                    {{/if}}
                </div>
            </div>

            <!-- Phân trang -->
            <nav class="mt-4 d-flex justify-content-center">
                <ul class="pagination">
                    <li class="page-item {{#if isFirstPage}}disabled{{/if}}">
                        <a class="page-link" href="?page={{prevPage}}">Trước</a>
                    </li>
                    {{#each pages}}
                    <li class="page-item {{#if active}}active{{/if}}">
                        <a class="page-link" href="?page={{this}}">{{this}}</a>
                    </li>
                    {{/each}}
                    <li class="page-item {{#if isLastPage}}disabled{{/if}}">
                        <a class="page-link" href="?page={{nextPage}}">Tiếp</a>
                    </li>
                </ul>
            </nav>
        </main>
    </div>
</div>

<script>
    function showFilter(type) {
        document.getElementById('filterPC').style.display = type === 'pc' ? 'block' : 'none';
        document.getElementById('filterComponent').style.display = type === 'component' ? 'block' : 'none';
        document.getElementById('typePC').classList.toggle('active', type === 'pc');
        document.getElementById('typeComponent').classList.toggle('active', type === 'component');
    }

    let lastGroup = null;
    document.querySelectorAll('#filterComponent .component-checkbox').forEach(cb => {
        cb.addEventListener('change', function () {
            const group = cb.closest('.filter-group').getAttribute('data-group');
            if (cb.checked) {
                if (lastGroup && lastGroup !== group) {
                    document.querySelectorAll(`#filterComponent .filter-group[data-group="${lastGroup}"] .component-checkbox`).forEach(other => other.checked = false);
                }
                lastGroup = group;
            }
        });
    });
</script>