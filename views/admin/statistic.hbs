<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
</head>

<body>
    <div class="container mt-5">
        <h1 class="mb-4">Doanh thu và lợi nhuận tích lũy</h1>
        <div class="card">
            <div class="card-body">
                <div id="revenueChart" width="200" height="200"></div>
            </div>
        </div>
    </div>
    <script>
        const accumulatedRevenue = {{{ json accumulatedRevenue }}};
        const accumulatedProfit = {{{ json accumulatedProfit }}};
        const options = {
            chart: {
                type: 'line'
            },
            series: [
                {
                    name: accumulatedRevenue.name,
                    data: accumulatedRevenue.values
                }
                , {
                    name: accumulatedProfit.name,
                    data: accumulatedProfit.values
                }
            ],
            xaxis: {
                categories: accumulatedRevenue.xaxis
            },
            colors: ['#008FFB', '#00E396'],
            stroke: {
                width: [3, 3],
                dashArray: [0, 8]
            },
            tooltip: {
                y: {
                    formatter: (val) => val.toLocaleString('vi-VN') + " VND"
                }
            },
        }

        const chart = new ApexCharts(document.getElementById('revenueChart'), options)
        chart.render()
    </script>
</body>

</html>