<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1"><i class="bi bi-receipt me-2"></i>Chi Tiết Đơn Hàng</h3>
            <p class="text-muted mb-0">Mã đơn hàng: <strong>{{order.id}}</strong></p>
        </div>
        <a href="/admin/orders" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <div class="row g-4">
        <!-- Cột bên trái: Thông tin đơn hàng và sản phẩm -->
        <div class="col-lg-8">
            <!-- Thông tin khách hàng -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>Thông Tin Khách Hàng</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Người nhận:</label>
                            <div class="fw-semibold">{{order.fullName}}</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Email:</label>
                            <div class="fw-semibold">{{order.email}}</div>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="text-muted small">Địa chỉ giao hàng:</label>
                            <div class="fw-semibold">{{order.address}}</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Danh sách sản phẩm -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Sản Phẩm Trong Đơn</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Phân loại</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#if order.items}}
                                    {{#each order.items}}
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">{{this.productName}}</div>
                                        </td>
                                        <td>
                                            {{#if this.distinctFeature}}
                                            <span class="badge bg-light text-dark">{{this.distinctFeature}}</span>
                                            {{else}}
                                            <span class="text-muted">-</span>
                                            {{/if}}
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-primary">×{{this.quantity}}</span>
                                        </td>
                                        <td class="text-end">{{formatPrice this.price}} VND</td>
                                        <td class="text-end fw-semibold text-danger">{{lineTotal this.price this.quantity}} VND</td>
                                    </tr>
                                    {{/each}}
                                {{else}}
                                <tr>
                                    <td colspan="5" class="text-center text-muted">Không có sản phẩm</td>
                                </tr>
                                {{/if}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Lịch sử trạng thái -->
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Lịch Sử Trạng Thái</h5>
                </div>
                <div class="card-body">
                    {{#if order.status}}
                    <div class="timeline">
                        {{#each order.status}}
                        <div class="timeline-item mb-3">
                            <div class="d-flex align-items-start">
                                <div class="timeline-marker">
                                    <i class="bi bi-circle-fill text-primary"></i>
                                </div>
                                <div class="ms-3 flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge {{#if (eq this.status 'pending')}}bg-warning{{else if (eq this.status 'processing')}}bg-info{{else if (eq this.status 'shipping')}}bg-primary{{else if (eq this.status 'delivered')}}bg-success{{else if (eq this.status 'cancelled')}}bg-danger{{else}}bg-secondary{{/if}}">
                                            {{#if (eq this.status 'pending')}}Chờ xử lý
                                            {{else if (eq this.status 'processing')}}Đang xử lý
                                            {{else if (eq this.status 'shipping')}}Đang giao hàng
                                            {{else if (eq this.status 'delivered')}}Đã giao hàng
                                            {{else if (eq this.status 'cancelled')}}Đã hủy
                                            {{else}}{{this.status}}{{/if}}
                                        </span>
                                        <small class="text-muted">{{formatDate this.createdAt}}</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                    {{else}}
                    <p class="text-muted mb-0">Chưa có lịch sử trạng thái</p>
                    {{/if}}
                </div>
            </div>
        </div>

        <!-- Cột bên phải: Tóm tắt thanh toán và cập nhật trạng thái -->
        <div class="col-lg-4">
            <!-- Cập nhật trạng thái -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-arrow-repeat me-2"></i>Cập Nhật Trạng Thái</h5>
                </div>
                <div class="card-body">
                    {{#if order.nextStatus}}
                    {{#if order.nextStatus.length}}
                    <label class="form-label">Chọn trạng thái mới:</label>
                    <select class="form-select mb-3" id="newStatusSelect">
                        <option value="">-- Chọn trạng thái --</option>
                        {{#each order.nextStatus}}
                        <option value="{{this}}">
                            {{#if (eq this 'pending')}}Chờ xử lý
                            {{else if (eq this 'processing')}}Đang xử lý
                            {{else if (eq this 'shipping')}}Đang giao hàng
                            {{else if (eq this 'delivered')}}Đã giao hàng
                            {{else if (eq this 'cancelled')}}Đã hủy
                            {{else}}{{this}}{{/if}}
                        </option>
                        {{/each}}
                    </select>
                    <button class="btn btn-primary w-100" onclick="updateOrderStatus()">
                        <i class="bi bi-check-circle me-1"></i>Cập Nhật Trạng Thái
                    </button>
                    {{else}}
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-2"></i>Đơn hàng đã ở trạng thái cuối cùng
                    </div>
                    {{/if}}
                    {{else}}
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>Không có trạng thái kế tiếp
                    </div>
                    {{/if}}
                </div>
            </div>

            <!-- Tóm tắt thanh toán -->
            <div class="card shadow-sm position-sticky" style="top: 20px;">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-cash-coin me-2"></i>Tóm Tắt Thanh Toán</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span>Tạm tính:</span>
                            <span>{{formatPrice order.totalPrice}} VND</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span>Tổng giảm giá:</span>
                            <span class="text-success">-{{formatPrice order.totalDiscount}} VND</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span>Phí vận chuyển:</span>
                            <span>{{formatPrice order.shippingFee}} VND</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span>Thuế (10%):</span>
                            <span>{{formatPrice order.tax}} VND</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0 fw-bold text-danger border-top">
                            <span>Tổng thanh toán:</span>
                            <span>{{formatPrice order.totalPay}} VND</span>
                        </li>
                    </ul>
                    <div class="border-top pt-3">
                        <div class="mb-2">
                            <label class="text-muted small">Phương thức vận chuyển:</label>
                            <div class="fw-semibold">{{order.shippingMethod}}</div>
                        </div>
                        <div>
                            <label class="text-muted small">Phương thức thanh toán:</label>
                            <div class="fw-semibold">COD (Thanh toán khi nhận hàng)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function updateOrderStatus() {
        const statusSelect = document.getElementById('newStatusSelect');
        const newStatus = statusSelect.value;
        
        if (!newStatus) {
            alert('Vui lòng chọn trạng thái mới!');
            return;
        }
        
        if (!confirm(`Bạn có chắc chắn muốn cập nhật trạng thái thành "${newStatus}"?`)) {
            return;
        }
        
        try {
            const response = await fetch('/admin/api/orders/{{order.id}}/status', {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ status: newStatus })
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert('Cập nhật trạng thái thành công!');
                window.location.reload();
            } else {
                alert('Lỗi: ' + result.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Có lỗi xảy ra khi cập nhật trạng thái!');
        }
    }
</script>

<style>
    .timeline {
        position: relative;
    }
    
    .timeline-item {
        position: relative;
        padding-left: 20px;
    }
    
    .timeline-item:not(:last-child)::before {
        content: '';
        position: absolute;
        left: 5px;
        top: 20px;
        bottom: -15px;
        width: 2px;
        background: #dee2e6;
    }
    
    .timeline-marker {
        position: absolute;
        left: 0;
        top: 5px;
    }
    
    .timeline-marker i {
        font-size: 12px;
    }
    
    .card {
        border-radius: 0.5rem;
        border: none;
    }
    
    .card-header {
        border-bottom: 2px solid #dee2e6;
        padding: 1rem 1.25rem;
    }
</style>
