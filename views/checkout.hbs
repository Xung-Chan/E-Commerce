<div class="container py-4" id="checkoutPage">
	<h2 class="fw-bold text-primary mb-4">Thanh toán</h2>
	<div class="row g-4">
		{{!-- Details information --}}
		<div class="col-lg-8 d-flex flex-column gap-4">

			<!-- Shipping Address -->
			<div class="card shadow-sm">
				<div class="card-header bg-white fw-semibold">Địa chỉ giao hàng</div>
				<div class="card-body" id="addressSection">
					{{#if user}}
						<div id="addressesList" class="d-flex flex-column gap-2 mb-3"></div>
						{{!-- <button class="btn btn-sm btn-outline-primary" id="addAddressToggle">+ Thêm địa chỉ mới</button>
						<form id="addAddressForm" class="mt-3 d-none">
							<div class="row g-2 mb-2">
								<div class="col-md-4">
									<label class="form-label small">Tỉnh/Thành phố</label>
									<select class="form-select form-select-sm" id="provinceSelectNew" required>
										<option value="">-- Chọn tỉnh/thành phố --</option>
									</select>
								</div>
								<div class="col-md-4">
									<label class="form-label small">Quận/Huyện</label>
									<select class="form-select form-select-sm" id="districtSelectNew" disabled required>
										<option value="">-- Chọn quận/huyện --</option>
									</select>
								</div>
								<div class="col-md-4">
									<label class="form-label small">Phường/Xã</label>
									<select class="form-select form-select-sm" id="wardSelectNew" disabled required>
										<option value="">-- Chọn phường/xã --</option>
									</select>
								</div>
							</div>
							<div class="input-group">
								<input type="text" class="form-control" id="newAddressDetailInput" placeholder="Địa chỉ chi tiết (số nhà, tên đường)">
								<button class="btn btn-success" type="submit">Lưu</button>
								<button class="btn btn-outline-secondary" type="button" id="cancelAddAddress">Hủy</button>
							</div>
							<input type="hidden" id="newFullAddressInput">
							<div id="addAddressStatus" class="small mt-2"></div>
						</form> --}}
					{{else}}
						<div class="mb-3">
							<label for="guestEmailInput" class="form-label">Email liên hệ</label>
							<input type="email" class="form-control" id="guestEmailInput" placeholder="Nhập email của bạn">
							<small class="text-muted">Chúng tôi sẽ gửi thông tin đơn hàng qua email này.</small>
						</div>
						<div class="mb-2">
							<label class="form-label">Địa chỉ giao hàng</label>
							<div class="row g-2 mb-2">
								<div class="col-md-4">
									<label class="form-label small">Tỉnh/Thành phố</label>
									<select class="form-select form-select-sm" id="provinceSelectGuest" required>
										<option value="">-- Chọn tỉnh/thành phố --</option>
									</select>
								</div>
								<div class="col-md-4">
									<label class="form-label small">Quận/Huyện</label>
									<select class="form-select form-select-sm" id="districtSelectGuest" disabled required>
										<option value="">-- Chọn quận/huyện --</option>
									</select>
								</div>
								<div class="col-md-4">
									<label class="form-label small">Phường/Xã</label>
									<select class="form-select form-select-sm" id="wardSelectGuest" disabled required>
										<option value="">-- Chọn phường/xã --</option>
									</select>
								</div>
							</div>
							<input type="text" class="form-control form-control-sm" id="guestAddressDetailInput" placeholder="Địa chỉ chi tiết (số nhà, tên đường)" required>
							<input type="hidden" id="guestFullAddressInput">
						</div>
						<div id="guestInfoStatus" class="small"></div>
					{{/if}}
				</div>
			</div>

			{{!-- Payment Methods --}}
			<div class="card shadow-sm">
				<div class="card-header bg-white fw-semibold">Phương thức thanh toán</div>
				<div class="card-body" id="paymentSection">
					<div class="d-flex flex-column gap-2" id="paymentMethods">
						<div class="form-check">
							<input class="form-check-input" type="radio" name="paymentMethod" id="pmCOD" value="cod"
								checked>
							<label class="form-check-label" for="pmCOD">Thanh toán khi nhận hàng (COD)</label>
						</div>
					</div>
				</div>
			</div>

			{{!-- Shipping Methods --}}
			<div class="card shadow-sm">
				<div class="card-header bg-white fw-semibold">Phương thức vận chuyển</div>
				<div class="card-body" id="shippingMethodSection">
					<div class="d-flex flex-column gap-2" id="shippingMethods">
						<div class="text-muted small" id="shippingLoading">Đang tải phương thức vận chuyển...</div>
					</div>
					<div id="shippingNote" class="mt-3 small text-muted"></div>
				</div>
			</div>

			{{!-- Coupon --}}
			<div class="card shadow-sm">
				<div class="card-header bg-white fw-semibold">Mã giảm giá (Coupon)</div>
				<div class="card-body" id="couponSection">
					<div class="mb-3">
						<label for="couponInput" class="form-label">Mã coupon:</label>
						<div class="input-group">
							<input type="text" id="couponInput" class="form-control"
								placeholder="Nhập mã (chưa hoạt động)">
							<button class="btn btn-outline-primary" id="applyCouponBtn" disabled>Áp dụng</button>
						</div>
						<div id="couponStatus" class="small mt-2 text-muted">Tính năng coupon sẽ được triển khai sau.
						</div>
					</div>
				</div>
			</div>

			{{!-- Loyalty Points --}}
			<div class="card shadow-sm">
				<div class="card-header bg-white fw-semibold">Điểm khách hàng thân thiết</div>
				<div class="card-body" id="loyaltySection">
					<div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
						<div>
							<div class="small">Bạn có: <strong id="userPointsDisplay">{{points}}</strong> điểm</div>
							<small class="text-muted">Quy đổi: 1 điểm = 1.000 VNĐ</small>
						</div>
						<div>
							<button class="btn btn-sm btn-outline-success" id="applyPointsBtn">Áp dụng điểm</button>
							<button class="btn btn-sm btn-outline-secondary d-none" id="removePointsBtn">Bỏ áp
								dụng</button>
						</div>
					</div>
					<div class="border rounded p-3 bg-light mb-2">
						<div class="d-flex justify-content-between align-items-center">
							<span>Giảm giá từ điểm:</span>
							<span id="loyaltyDiscountDisplay" class="fw-semibold text-success">0 VND</span>
						</div>
						<small id="loyaltyStatus" class="text-muted d-block mt-2">Chưa áp dụng điểm.</small>
					</div>
				</div>
			</div>
		</div>

		<!-- Order Summary -->
		<div class="col-lg-4">
			<div class="card shadow-sm position-sticky" style="top:20px;">
				<div class="card-header bg-white fw-semibold">Tóm tắt đơn hàng</div>
				<div class="card-body" id="summarySection">
					<div id="itemsList" class="mb-3 d-flex flex-column gap-2"></div>
					<hr>
					<ul class="list-group list-group-flush mb-3">
						<li class="list-group-item d-flex justify-content-between">
							<span>Tạm tính:</span>
							<span id="subtotalDisplay">0 VND</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							<span>Thuế (10%):</span>
							<span id="taxDisplay">0 VND</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							<span>Phí vận chuyển:</span>
							<span id="shippingDisplay">0 VND</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							<span>Giảm giá coupon:</span>
							<span id="couponDiscountDisplay">0 VND</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							<span>Giảm giá thân thiết:</span>
							<span id="loyaltyDiscountDisplaySummary">0 VND</span>
						</li>
						<li class="list-group-item d-flex justify-content-between fw-bold">
							<span>Tổng cộng:</span>
							<span id="totalDisplay">0 VND</span>
						</li>
					</ul>
					<button class="btn btn-success w-100 mb-2" id="confirmOrderBtn" disabled>Xác nhận đặt hàng</button>
					<div id="orderStatus" class="small"></div>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		// State
		const userPoints = Number('{{points}}') || 0;
		const isLoggedIn = {{#if user}}true{{else}}false{{/if}};
		const userIdInCommon = '{{userId}}';
		const POINT_VALUE = 1000;

		let addresses = [];
		let cartItems = [];
		let couponCode = '';
		let shippingFee = 0;
		let couponDiscount = 0;
		let loyaltyDiscount = 0;
		let shippingMethods = [];

		let couponId = null;
		let selectedAddressId = null;
		let couponPercentApplied = null;
		let loyaltyPointsApplied = false;
		let selectedShippingMethod = null;
		let selectedShippingMethodId = null;

		// Elements
		const addressesListEl = document.getElementById('addressesList');
		const addAddressToggleBtn = document.getElementById('addAddressToggle');
		const addAddressForm = document.getElementById('addAddressForm');
		const newAddressInput = document.getElementById('newAddressInput');
		const cancelAddAddressBtn = document.getElementById('cancelAddAddress');
		const addAddressStatus = document.getElementById('addAddressStatus');
		const guestEmailInput = document.getElementById('guestEmailInput');
		// Guest address dropdowns
		const provinceSelectGuest = document.getElementById('provinceSelectGuest');
		const districtSelectGuest = document.getElementById('districtSelectGuest');
		const wardSelectGuest = document.getElementById('wardSelectGuest');
		const guestAddressDetailInput = document.getElementById('guestAddressDetailInput');
		const guestFullAddressInput = document.getElementById('guestFullAddressInput');
		// New address (logged-in) dropdowns
		const provinceSelectNew = document.getElementById('provinceSelectNew');
		const districtSelectNew = document.getElementById('districtSelectNew');
		const wardSelectNew = document.getElementById('wardSelectNew');
		const newAddressDetailInput = document.getElementById('newAddressDetailInput');
		const newFullAddressInput = document.getElementById('newFullAddressInput');
		const guestInfoStatus = document.getElementById('guestInfoStatus');

		const couponInput = document.getElementById('couponInput');
		const applyCouponBtn = document.getElementById('applyCouponBtn');
		const couponStatus = document.getElementById('couponStatus');

		const loyaltyDiscountDisplay = document.getElementById('loyaltyDiscountDisplay');
		const applyPointsBtn = document.getElementById('applyPointsBtn');
		const removePointsBtn = document.getElementById('removePointsBtn');
		const loyaltyStatus = document.getElementById('loyaltyStatus');
		const userPointsDisplay = document.getElementById('userPointsDisplay');

		const itemsListEl = document.getElementById('itemsList');
		const subtotalDisplay = document.getElementById('subtotalDisplay');
		const taxDisplay = document.getElementById('taxDisplay');
		const shippingDisplay = document.getElementById('shippingDisplay');
		const couponDiscountDisplay = document.getElementById('couponDiscountDisplay');
		const loyaltyDiscountDisplaySummary = document.getElementById('loyaltyDiscountDisplaySummary');
		const totalDisplay = document.getElementById('totalDisplay');
		const confirmOrderBtn = document.getElementById('confirmOrderBtn');
		const orderStatus = document.getElementById('orderStatus');
		const shippingNote = document.getElementById('shippingNote');
		const shippingMethodsEl = document.getElementById('shippingMethods');

		// Helpers
		function formatPrice(n) { return (n || 0).toLocaleString('vi-VN') + ' VND'; }
		function setStatus(el, message, type = 'info') {
			if (!el) return; el.textContent = message; el.className = 'small text-' + type;
		}
		function calcLoyaltyDiscount(subtotal) {
			if (!loyaltyPointsApplied) return 0;
			const maxFromPoints = userPoints * POINT_VALUE;
			return Math.min(maxFromPoints, subtotal);
		}

		// Render addresses
		function renderAddresses() {
			if (!isLoggedIn) {
				selectedAddressId = null;
				updateConfirmState();
				return;
			}
			addressesListEl.innerHTML = '';
			if (!addresses.length) {
				addressesListEl.innerHTML = '<div class="text-muted small">Chưa có địa chỉ. Thêm mới ở dưới.</div>';
				selectedAddressId = null;
				updateConfirmState();
				return;
			}
			if (!selectedAddressId) {
				const first = addresses[0];
				selectedAddressId = first._id || first.id || first.addressId || first.address;
			}
			addresses.forEach(addr => {
				const id = addr._id || addr.id || addr.addressId || addr.address || Math.random().toString(36).slice(2);
				const wrapper = document.createElement('div');
				wrapper.className = 'form-check';
				wrapper.innerHTML = `
					<input class="form-check-input" type="radio" name="shippingAddress" id="addr_${id}" value="${id}" ${selectedAddressId === id ? 'checked' : ''}>
					<label class="form-check-label" for="addr_${id}">${addr.address || addr}</label>
				`;
				const input = wrapper.querySelector('input');
				input.addEventListener('change', () => { selectedAddressId = id; updateConfirmState(); });
				addressesListEl.appendChild(wrapper);
			});
			updateConfirmState();
		}

		// Render cart items
		function renderCartItems() {
			itemsListEl.innerHTML = '';
			if (!cartItems.length) {
				itemsListEl.innerHTML = '<div class="text-muted small">Giỏ hàng trống.</div>';
				updateSummary();
				return;
			}
			cartItems.forEach(i => {
				const div = document.createElement('div');
				div.className = 'd-flex justify-content-between align-items-start';
				div.innerHTML = `
					<div class="me-2" style="max-width:70%;">
						<div class="fw-semibold text-truncate" title="${i.productName}">${i.productName}</div>
						<div class="small text-muted text-truncate" title="${i.distinctFeature || ''}">${i.distinctFeature || ''}</div>
						<div class="small">x ${i.quantity}</div>
					</div>
					<div class="text-end fw-semibold text-danger">${formatPrice(i.price * i.quantity)}</div>
				`;
				itemsListEl.appendChild(div);
			});
			updateSummary();
		}

		// Update summary calculations
		function updateSummary() {
			const subtotal = cartItems.reduce((s, i) => s + i.price * i.quantity, 0);
			if (typeof couponPercentApplied === 'number' && couponPercentApplied > 0) {
				couponDiscount = Math.round(subtotal * (couponPercentApplied / 100));
			}
			loyaltyDiscount = calcLoyaltyDiscount(subtotal);
			const tax = Math.round(subtotal * 0.10);
			const total = subtotal + tax + shippingFee - couponDiscount - loyaltyDiscount;
			subtotalDisplay.textContent = formatPrice(subtotal);
			taxDisplay.textContent = formatPrice(tax);
			shippingDisplay.textContent = formatPrice(shippingFee);
			couponDiscountDisplay.textContent = formatPrice(couponDiscount);
			loyaltyDiscountDisplay.textContent = formatPrice(loyaltyDiscount);
			loyaltyDiscountDisplaySummary.textContent = formatPrice(loyaltyDiscount);
			totalDisplay.textContent = formatPrice(Math.max(total, 0));
			updateConfirmState();
			if (loyaltyPointsApplied) {
				loyaltyStatus.textContent = `Đã áp dụng ${userPoints} điểm (giảm ${formatPrice(loyaltyDiscount)})`;
				loyaltyStatus.className = 'text-success small d-block mt-2';
			} else {
				loyaltyStatus.textContent = 'Chưa áp dụng điểm.';
				loyaltyStatus.className = 'text-muted small d-block mt-2';
			}
		}
		function updateConfirmState() {
			const hasPayment = !!document.querySelector('input[name="paymentMethod"]:checked');
			const guestEmail = guestEmailInput?.value?.trim();
			const guestAddress = guestFullAddressInput?.value?.trim();
			const hasUserAddress = isLoggedIn && !!selectedAddressId;
			const hasGuestInfo = !isLoggedIn && !!guestEmail && !!guestAddress;
			const ok = cartItems.length > 0 && hasPayment && (hasUserAddress || hasGuestInfo);
			confirmOrderBtn.disabled = !ok;
			if (!cartItems.length) {
				orderStatus.textContent = 'Giỏ hàng trống.';
				orderStatus.className = 'small text-muted';
			} else if (isLoggedIn && !selectedAddressId) {
				orderStatus.textContent = 'Vui lòng chọn địa chỉ giao hàng.';
				orderStatus.className = 'small text-warning';
			} else if (!isLoggedIn && !hasGuestInfo) {
				orderStatus.textContent = 'Vui lòng nhập email và địa chỉ giao hàng.';
				orderStatus.className = 'small text-warning';
			} else {
				orderStatus.textContent = '';
			}
		}

		function applyShippingMethod(m) {
			selectedShippingMethod = m || null;
			selectedShippingMethodId = m?._id || m?.id || null;
			if (m) {
				shippingFee = Number(m.price) || 0;
				shippingNote.textContent = m.description || '';
			} else {
				shippingFee = 0;
				shippingNote.textContent = 'Không tìm thấy phương thức vận chuyển.';
			}
			updateSummary();
		}

		// Render shipping methods
		function renderShippingMethods() {
			shippingMethodsEl.innerHTML = '';
			if (!shippingMethods.length) {
				shippingMethodsEl.innerHTML = '<div class="text-danger small">Không tải được phương thức vận chuyển.</div>';
				selectedShippingMethod = null;
				applyShippingMethod(null);
				return;
			}
			shippingMethods.forEach((m, idx) => {
				const wrapper = document.createElement('div');
				wrapper.className = 'form-check';
				const id = 'ship_' + m.name.replace(/[^a-zA-Z0-9_-]/g, '_');
				wrapper.innerHTML = `
						<input class="form-check-input" type="radio" name="shippingMethod" id="${id}" value="${m.name}" ${idx === 0 ? 'checked' : ''}>
						<label class="form-check-label" for="${id}">
							<span class="fw-semibold">${m.name}</span> - ${formatPrice(m.price)}
						</label>
					`;
				const input = wrapper.querySelector('input');
				input.addEventListener('change', () => { if (input.checked) applyShippingMethod(m); });
				shippingMethodsEl.appendChild(wrapper);
			});
			applyShippingMethod(shippingMethods[0]);
		}

		// Load shipping methods
		async function loadShippingMethods() {
			try {
				const resp = await fetch('/api/shipping-methods', { credentials: 'include' });
				if (!resp.ok) throw new Error();
				const data = await resp.json();
				shippingMethods = data?.data || data || [];
			} catch (e) {
				shippingMethods = [];
			}
			renderShippingMethods();
		}

		// Fetch data (cart + addresses)
		async function loadInitial() {
			const stored = sessionStorage.getItem('checkoutItems');
			if (stored) {
				try {
					cartItems = JSON.parse(stored) || [];
				} catch { cartItems = []; }
				sessionStorage.removeItem('checkoutItems');
			} else {
				try {
					const cartRes = await fetch('/api/users/cart/me', { credentials: 'include' });
					if (cartRes.ok) {
						const cartJson = await cartRes.json();
						cartItems = cartJson?.data?.items || cartJson?.items || [];
					}
				} catch { }
			}
			if (isLoggedIn) {
				try {
					const addrRes = await fetch('/api/users/addresses/me', { credentials: 'include' });
					if (addrRes.ok) {
						const addrJson = await addrRes.json();
						addresses = addrJson?.data || addrJson || [];
					}
				} catch { }
			}
			renderAddresses();
			renderCartItems();
			await loadShippingMethods();
		}


		// Coupon apply
		applyCouponBtn.removeAttribute('disabled');
		couponInput.placeholder = 'Nhập mã coupon';
		couponStatus.classList.remove('text-muted');
		couponStatus.textContent = '';
		applyCouponBtn.addEventListener('click', async () => {
			const inputCode = couponInput.value.trim();
			if (!inputCode) { setStatus(couponStatus, 'Vui lòng nhập mã.', 'warning'); return; }
			couponDiscount = 0;
			couponId = null;
			couponCode = '';
			couponPercentApplied = null;
			
			try {
				const resp = await fetch('/api/coupons/code?code=' + encodeURIComponent(inputCode), { credentials: 'include' });
				if (!resp.ok) throw new Error('Coupon fetch failed');
				const json = await resp.json();
				
				const coupon = json?.data || json?.coupon || json || null;
				if (!coupon) throw new Error('No coupon data');
				console.log('Coupon data:', coupon);
				couponId = coupon._id;
				if (coupon.maxUse <= coupon.used) {
					setStatus(couponStatus, 'Coupon đã hết lượt sử dụng.', 'warning');
					couponId = null; couponCode = ''; couponPercentApplied = null;
				} else if (coupon.status == "inactive") {
					setStatus(couponStatus, 'Coupon không hoạt động.', 'warning');
					couponId = null; couponCode = ''; couponPercentApplied = null;
				} 
				else if (typeof coupon.discount === 'number' && coupon.discount > 0) {
					couponPercentApplied = Number(coupon.discount);
					const subtotalNow = cartItems.reduce((s, i) => s + i.price * i.quantity, 0);
					couponDiscount = Math.round(subtotalNow * (couponPercentApplied / 100));
					couponCode = inputCode;
					setStatus(couponStatus, `Giảm ${couponPercentApplied}% (-${formatPrice(couponDiscount)})`, 'success');
				} else {
					setStatus(couponStatus, 'Coupon không hợp lệ.', 'warning');
				}
			} catch (e) {
				couponDiscount = 0;
				couponId = null; couponCode = ''; couponPercentApplied = null;
				setStatus(couponStatus, 'Coupon không hợp lệ.', 'danger');
			}
			updateSummary();
		});

		applyPointsBtn.addEventListener('click', () => {
			if (!userPoints) {
				loyaltyStatus.textContent = 'Bạn không có điểm để áp dụng.';
				loyaltyStatus.className = 'text-danger small d-block mt-2';
				return;
			}
			loyaltyPointsApplied = true;
			applyPointsBtn.classList.add('d-none');
			removePointsBtn.classList.remove('d-none');
			updateSummary();
		});

		removePointsBtn.addEventListener('click', () => {
			loyaltyPointsApplied = false;
			applyPointsBtn.classList.remove('d-none');
			removePointsBtn.classList.add('d-none');
			updateSummary();
		});

		// Disable loyalty for guests
		if (!isLoggedIn) {
			loyaltyPointsApplied = false;
			if (applyPointsBtn) { applyPointsBtn.disabled = true; applyPointsBtn.title = 'Chỉ dành cho khách hàng đã đăng nhập'; }
			if (removePointsBtn) { removePointsBtn.disabled = true; }
			if (loyaltyStatus) { loyaltyStatus.textContent = 'Chỉ dành cho khách hàng đã đăng nhập.'; loyaltyStatus.className = 'text-muted small d-block mt-2'; }
			updateSummary();
		}

		// Address dropdown helpers (shared)
		const API_BASE = 'https://api.mysupership.vn/v1/partner/areas';

		// Compose full address for guest
		let selectedProvinceGuest = null, selectedDistrictGuest = null, selectedWardGuest = null;
		function composeGuestFullAddress(){
			const parts = [];
			const detail = guestAddressDetailInput?.value?.trim();
			if (detail) parts.push(detail);
			if (selectedWardGuest) parts.push(selectedWardGuest);
			if (selectedDistrictGuest) parts.push(selectedDistrictGuest);
			if (selectedProvinceGuest) parts.push(selectedProvinceGuest);
			if (guestFullAddressInput) guestFullAddressInput.value = parts.join(', ');
		}

		async function loadProvinces(selectEl){
			try {
				const response = await fetch(`${API_BASE}/province`);
				const json = await response.json();
				const provinces = json?.results || json?.data || [];
				if (!selectEl) return;
				selectEl.innerHTML = '<option value="">-- Chọn tỉnh/thành phố --</option>';
				provinces.forEach(p => {
					const option = document.createElement('option');
					option.value = p.code || p.id;
					option.textContent = p.name;
					option.dataset.name = p.name;
					selectEl.appendChild(option);
				});
			} catch (e) { }
		}

		async function loadDistricts(selectEl, provinceCode){
			try {
				const response = await fetch(`${API_BASE}/district?province=${provinceCode}`);
				const json = await response.json();
				const districts = json?.results || json?.data || [];
				if (!selectEl) return;
				selectEl.innerHTML = '<option value="">-- Chọn quận/huyện --</option>';
				selectEl.disabled = false;
				districts.forEach(d => {
					const option = document.createElement('option');
					option.value = d.code || d.id;
					option.textContent = d.name;
					option.dataset.name = d.name;
					selectEl.appendChild(option);
				});
			} catch (e) { }
		}

		async function loadWards(selectEl, districtCode){
			try {
				const response = await fetch(`${API_BASE}/commune?district=${districtCode}`);
				const json = await response.json();
				const wards = json?.results || json?.data || [];
				if (!selectEl) return;
				selectEl.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
				selectEl.disabled = false;
				wards.forEach(w => {
					const option = document.createElement('option');
					option.value = w.code || w.id;
					option.textContent = w.name;
					option.dataset.name = w.name;
					selectEl.appendChild(option);
				});
			} catch (e) { }
		}

		// Initialize guest dropdowns
		if (provinceSelectGuest && districtSelectGuest && wardSelectGuest){
			loadProvinces(provinceSelectGuest);
			provinceSelectGuest.addEventListener('change', (e)=>{
				const code = e.target.value;
				const opt = e.target.options[e.target.selectedIndex];
				selectedProvinceGuest = opt?.dataset?.name || '';
				guestFullAddressInput.value = '';
				if (code){
					loadDistricts(districtSelectGuest, code);
					wardSelectGuest.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
					wardSelectGuest.disabled = true;
				} else {
					districtSelectGuest.innerHTML = '<option value="">-- Chọn quận/huyện --</option>';
					districtSelectGuest.disabled = true;
					wardSelectGuest.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
					wardSelectGuest.disabled = true;
					selectedDistrictGuest = null; selectedWardGuest = null;
				}
				composeGuestFullAddress(); updateConfirmState();
			});
			districtSelectGuest.addEventListener('change', (e)=>{
				const code = e.target.value;
				const opt = e.target.options[e.target.selectedIndex];
				selectedDistrictGuest = opt?.dataset?.name || '';
				if (code){
					loadWards(wardSelectGuest, code);
				} else {
					wardSelectGuest.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
					wardSelectGuest.disabled = true;
					selectedWardGuest = null;
				}
				composeGuestFullAddress(); updateConfirmState();
			});
			wardSelectGuest.addEventListener('change', (e)=>{
				const opt = e.target.options[e.target.selectedIndex];
				selectedWardGuest = opt?.dataset?.name || '';
				composeGuestFullAddress(); updateConfirmState();
			});
		}

		// Initialize 'add new address' dropdowns for logged-in
		let selectedProvinceNew = null, selectedDistrictNew = null, selectedWardNew = null;
		function composeNewFullAddress(){
			const parts = [];
			const detail = newAddressDetailInput?.value?.trim();
			if (detail) parts.push(detail);
			if (selectedWardNew) parts.push(selectedWardNew);
			if (selectedDistrictNew) parts.push(selectedDistrictNew);
			if (selectedProvinceNew) parts.push(selectedProvinceNew);
			if (newFullAddressInput) newFullAddressInput.value = parts.join(', ');
		}

		if (provinceSelectNew && districtSelectNew && wardSelectNew){
			loadProvinces(provinceSelectNew);
			provinceSelectNew.addEventListener('change', (e)=>{
				const code = e.target.value;
				const opt = e.target.options[e.target.selectedIndex];
				selectedProvinceNew = opt?.dataset?.name || '';
				if (code){
					loadDistricts(districtSelectNew, code);
					wardSelectNew.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
					wardSelectNew.disabled = true;
				} else {
					districtSelectNew.innerHTML = '<option value="">-- Chọn quận/huyện --</option>';
					districtSelectNew.disabled = true;
					wardSelectNew.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
					wardSelectNew.disabled = true;
					selectedDistrictNew = null; selectedWardNew = null;
				}
				composeNewFullAddress();
			});
			districtSelectNew.addEventListener('change', (e)=>{
				const code = e.target.value;
				const opt = e.target.options[e.target.selectedIndex];
				selectedDistrictNew = opt?.dataset?.name || '';
				if (code){
					loadWards(wardSelectNew, code);
				} else {
					wardSelectNew.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
					wardSelectNew.disabled = true;
					selectedWardNew = null;
				}
				composeNewFullAddress();
			});
			wardSelectNew.addEventListener('change', (e)=>{
				const opt = e.target.options[e.target.selectedIndex];
				selectedWardNew = opt?.dataset?.name || '';
				composeNewFullAddress();
			});
			if (newAddressDetailInput) newAddressDetailInput.addEventListener('input', composeNewFullAddress);
		}

		// Add address toggle (only if logged in UI exists)
		if (addAddressToggleBtn && addAddressForm && newAddressInput && addAddressStatus) {
			addAddressToggleBtn.addEventListener('click', () => {
				addAddressForm.classList.toggle('d-none');
				newAddressInput.value = '';
				setStatus(addAddressStatus, '');
			});
			if (cancelAddAddressBtn) {
				cancelAddAddressBtn.addEventListener('click', () => {
					addAddressForm.classList.add('d-none');
					newAddressInput.value = '';
					setStatus(addAddressStatus, '');
				});
			}
			addAddressForm.addEventListener('submit', async (e) => {
				e.preventDefault();
				const val = newAddressInput.value.trim();
				if (!val) { setStatus(addAddressStatus, 'Địa chỉ không được trống.', 'warning'); return; }
				setStatus(addAddressStatus, 'Đang lưu...', 'info');
				try {
					const resp = await fetch('/api/users/addresses/me', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						credentials: 'include',
						body: JSON.stringify({ address: val })
					});
					if (!resp.ok) throw new Error();
					addresses.push({ address: val });
					selectedAddressId = addresses[addresses.length - 1].address;
					renderAddresses();
					addAddressForm.classList.add('d-none');
					setStatus(addAddressStatus, 'Đã thêm địa chỉ.', 'success');
				} catch (e) {
					setStatus(addAddressStatus, 'Lỗi thêm địa chỉ.', 'danger');
				}
			});
		}

		// Guest inputs should trigger state validation
		if (guestEmailInput) guestEmailInput.addEventListener('input', updateConfirmState);
		if (guestAddressDetailInput) guestAddressDetailInput.addEventListener('input', () => { composeGuestFullAddress(); updateConfirmState(); });

		// Confirm order
		confirmOrderBtn.addEventListener('click', async () => {
			if (confirmOrderBtn.disabled) return;
			confirmOrderBtn.disabled = true;
			const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value;
			const variants = cartItems.map(i => ({ variantId: i.variantId, quantity: i.quantity }));
			let addressText = null;
			let finalUserId = null;

			if (isLoggedIn) {
				const addrObj = addresses.find(a => (a._id || a.id || a.addressId || a.address) === selectedAddressId);
				addressText = addrObj?.address || null;
				finalUserId = (userIdInCommon && userIdInCommon !== 'anonymous') ? userIdInCommon : null;
			} else {
				const guestEmail = guestEmailInput?.value?.trim();
				const guestAddress = guestFullAddressInput?.value?.trim();
				if (!guestEmail || !guestAddress) {
					setStatus(guestInfoStatus, 'Vui lòng nhập email và địa chỉ giao hàng.', 'warning');
					confirmOrderBtn.disabled = false;
					return;
				}
				addressText = guestAddress;
				// Register anonymous user to obtain userId
				try {
					const regResp = await fetch('/api/auth/register', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						credentials: 'include',
						body: JSON.stringify({ email: guestEmail, address: guestAddress, isAnonymous: true })
					});
					const regJson = await regResp.json().catch(() => ({}));
					const regData = regJson?.data || regJson?.user || regJson;
					finalUserId = regData?._id || regData?.id || regJson?.userId || null;
					// Nếu email đã tồn tại, API có thể trả lỗi nhưng vẫn kèm userId -> vẫn tiếp tục
					if (!finalUserId) {
						const msg = regJson?.message || regJson?.error || 'Không lấy được userId sau đăng ký/kiểm tra email';
						throw new Error(msg);
					}
				} catch (e) {
					setStatus(orderStatus, e.message || 'Không thể tạo/tìm tài khoản ẩn danh.', 'danger');
					confirmOrderBtn.disabled = false;
					return;
				}
			}

			const payload = {
				variants,
				shippingMethodId: selectedShippingMethodId,
				isUseUserPoint: loyaltyPointsApplied,
				address: addressText
			};
			if (finalUserId) payload.userId = finalUserId;
			if (couponId) {
				payload.couponId = couponId;
			}
			
			try {
				const resp = await fetch('/api/orders', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					credentials: 'include',
					body: JSON.stringify(payload)
				});
				
				if (!resp.ok) {
					const errorData = await resp.json();
					const errorMessage = errorData?.message || errorData?.error || 'Lỗi đặt hàng';
					throw new Error(errorMessage);
				}
				
				const json = await resp.json();
				const createdOrder = json?.data || json?.order || null;
				const oid = createdOrder?._id || createdOrder?.orderId || json?.data?.orderId || json?.orderId;
				setStatus(orderStatus, 'Đặt hàng thành công! Đang chuyển hướng...', 'success');
				
				if (oid) {
					setTimeout(() => { window.location.href = '/order/result/' + oid; }, 800);
				} else {
					setStatus(orderStatus, 'Đặt hàng thành công nhưng không lấy được mã đơn.', 'warning');
					confirmOrderBtn.disabled = false;
				}
			} catch (e) {
				const errorMsg = e.message || 'Lỗi đặt hàng. Vui lòng thử lại.';
				setStatus(orderStatus, errorMsg, 'danger');
				confirmOrderBtn.disabled = false;
			}
		});

		loadInitial();
	});
</script>