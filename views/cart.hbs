<div class="container py-4">
	<h2 class="fw-bold text-primary mb-4">Giỏ hàng</h2>

	{{#if errorMessage}}
		<div class="alert alert-danger">{{errorMessage}}</div>
	{{/if}}

	{{#if cartItems.length}}
	<div class="row g-4">
		<div class="col-lg-8">
			<div class="card shadow-sm">
				<div class="card-body p-0">
					<div class="table-responsive">
						<table class="table align-middle mb-0">
							<thead class="table-light">
								<tr>
									<th>Sản phẩm</th>
									<th>Biến thể</th>
									<th class="text-center" style="width:160px;">Số lượng</th>
									<th class="text-end" style="width:120px;">Hành động</th>
								</tr>
							</thead>
							<tbody>
								{{#each cartItems}}
								<tr>
									<td>{{this.product}}</td>
									<td><span class="badge text-bg-secondary">{{this.variant}}</span></td>
									<td>
										<form action="/cart/update/{{this.cartItemId}}" method="POST" class="d-flex justify-content-center align-items-center gap-2">
											<input type="number" class="form-control form-control-sm text-center" name="quantity" value="{{this.quantity}}" min="1" style="max-width:80px;">
											<button class="btn btn-sm btn-outline-primary" type="submit">Cập nhật</button>
										</form>
									</td>
									<td class="text-end">
										<form action="/cart/remove/{{this.cartItemId}}" method="POST" class="d-inline">
											<button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
										</form>
									</td>
								</tr>
								{{/each}}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="card shadow-sm">
				<div class="card-body">
					<h5 class="fw-bold mb-3">Tóm tắt</h5>
								<ul class="list-group list-group-flush mb-3">
									<li class="list-group-item d-flex justify-content-between align-items-center">
										Tổng số lượng
										<span class="badge text-bg-primary">{{totalItems}}</span>
									</li>
								</ul>
					<button class="btn btn-success w-100" disabled>Thanh toán (đang phát triển)</button>
				</div>
			</div>
		</div>
	</div>
	{{else}}
		<div class="text-center text-muted py-5">
			Giỏ hàng trống. <a href="/catalog" class="text-primary">Tiếp tục mua sắm</a>
		</div>
	{{/if}}
</div>

