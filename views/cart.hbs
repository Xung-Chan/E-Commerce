<div class="container py-4">
	<h2 class="fw-bold text-primary mb-4">Giỏ hàng</h2>

	{{#if errorMessage}}
	<div class="alert alert-danger">{{errorMessage}}</div>
	{{/if}}

	{{#if cart.items.length}}
	<div class="row g-4">
		<div class="col-lg-8">
			<div class="card shadow-sm">
				<div class="card-body p-0">
					<div class="table-responsive">
						<table class="table align-middle mb-0">
							<thead class="table-light">
								<tr>
									<th>Sản phẩm</th>
									<th>Cấu hình</th>
									<th class="text-center">Số lượng</th>
									<th class="text-end">Hành động</th>
								</tr>
							</thead>
							<tbody>
								{{#each cart.items}}
								<tr>
									<td>
										<img src="{{this.imageUrl}}" alt="{{this.product}}" width="60" height="60"
											class="rounded object-fit-cover me-3"
											onerror="this.onerror=null;this.src='https://placehold.co/56x56?text=?';">
										{{this.product}}
									</td>
									<td>
										{{this.variant}}
									</td>
									<td>
										<form action="#" method="POST"
											class="d-flex justify-content-center align-items-center gap-2">
											<input type="number" class="form-control form-control-sm text-center"
												name="quantity" value="{{this.quantity}}" min="1"
												style="max-width:80px;">
										</form>
									</td>
									<td class="text-end justify-content-center align-items-center" style="gap: 0.5rem;">
										<form action="/cart/me/{{this.cartItemId}}" method="POST" class="d-inline">
											<button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
										</form>
									</td>
								</tr>
								{{/each}}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="card shadow-sm">
				<div class="card-body">
					<h5 class="fw-bold mb-3">Tóm tắt</h5>
					<ul class="list-group list-group-flush mb-3">
						{{#each cart.items}}
						<li class="list-group-item d-flex justify-content-between align-items-center">
							{{this.product}} (x{{this.quantity}})
						</li>
						{{/each}}
						<li class="list-group-item d-flex justify-content-between align-items-center">
							Thuế:
							<span>{{formatPrice cart.tax}} VND</span>
						</li>
						<li class="list-group-item d-flex justify-content-between align-items-center">
							Phí vận chuyển:
							<span>{{formatPrice cart.shippingCost}} VND</span>
						</li>
						<li class="list-group-item d-flex justify-content-between align-items-center fw-bold">
							Tổng cộng:
							<span>{{formatPrice cart.totalPrice}} VND</span>
					</ul>
					<button class="btn btn-success w-100" disabled>Thanh toán</button>
				</div>
			</div>
		</div>
	</div>
	{{else}}
	<div class="text-center text-muted py-5">
		Giỏ hàng trống. <a href="/catalog" class="text-primary">Tiếp tục mua sắm</a>
	</div>
	{{/if}}
</div>