<div class="container py-4">
	{{!-- Style cho giỏ hàng --}}
	<style>
		#cartTable .cart-product-cell { overflow: hidden; }
		#cartTable .cart-product-cell .product-info { min-width: 0; }
		#cartTable .product-name { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
		#cartTable td.small { word-break: break-word; }
		@media (max-width: 992px) {
			#cartTable .product-name { white-space: normal; }
		}
	</style>


	{{!-- Giỏ hàng --}}
	{{#if cart.items.length}}
	<h2 class="fw-bold text-primary mb-2">Giỏ hàng</h2>
	<div class="row g-4">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body p-0">
					<div class="table-responsive">
						<table class="table table-hover align-middle mb-0 cart-table w-100" id="cartTable" style="table-layout: fixed; width:100%;">
							<colgroup>
								<col style="width:50px;" />
								<col style="width:260px;" />
								<col style="width:170px;" />
								<col style="width:150px;" />
								<col style="width:160px;" />
								<col style="width:130px;" />
							</colgroup>
							<thead class="table-light">
								<tr>
									<th style="min-width:45px;">
										<input type="checkbox" id="selectAll">
									</th>
									<th style="min-width:240px;">Sản phẩm</th>
									<th style="min-width:160px;">Cấu hình</th>
									<th class="text-center" style="min-width:110px;">Số lượng</th>
									<th class="text-end" style="min-width:140px;">Giá (x Qty)</th>
									<th class="text-end" style="min-width:120px;">Hành động</th>
								</tr>
							</thead>
							<tbody>
								{{#each cart.items}}
								<tr data-price="{{this.price}}" data-quantity="{{this.quantity}}" data-cart-item-id="{{this.cartItemId}}" data-variant-id="{{this.variantId}}">
									<td class="align-middle">
										<input type="checkbox" class="item-checkbox">
									</td>
									<td class="cart-product-cell">
										<div class="d-flex align-items-center gap-2">
											<img src="{{this.productImage}}" alt="{{this.product}}" width="60" height="60"
												class="rounded object-fit-cover"
												onerror="this.onerror=null;this.src='https://placehold.co/56x56?text=?';">
											<div class="flex-grow-1 product-info">
												<span class="fw-semibold product-name" title="{{this.productName}}">{{this.productName}}</span>
											</div>
										</div>
									</td>
									<td class="small">{{this.distinctFeature}}</td>
									<td class="text-center">
										<div class="quantity-control d-inline-flex align-items-center" style="gap:4px;">
											<button type="button" class="btn btn-sm btn-outline-secondary btn-qty" data-action="dec">-</button>
											<input type="number" class="form-control form-control-sm qty-input" min="1" value="{{this.quantity}}" style="width:64px;">
											<button type="button" class="btn btn-sm btn-outline-secondary btn-qty" data-action="inc">+</button>
										</div>
									</td>
									<td class="text-end fw-semibold text-danger line-total">{{lineTotal this.price this.quantity}} VND</td>
									<td class="text-end">
										<button type="button" class="btn btn-sm btn-outline-danger btn-remove">Xóa</button>
									</td>
								</tr>
								{{/each}}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>


		{{!-- Tóm tắt --}}
		<div class="col-12 mt-3">
			<div class="card shadow-sm">
				<div class="card-body">
					<h5 class="fw-bold mb-3">Tóm tắt</h5>
					<ul class="list-group list-group-flush mb-3">
						<li class="list-group-item d-flex justify-content-between align-items-center">
							Thuế:
							<span id="taxAmount">{{formatPrice tax}} VND</span>
						</li>
						<li class="list-group-item d-flex justify-content-between align-items-center fw-bold">
							Tổng cộng:
							<span id="totalAmount">{{formatPrice 0}} VND</span>
						</li>
					</ul>
					<button id="checkoutBtn" class="btn btn-success w-100" disabled>Thanh toán</button>
					<div id="cartStatus" class="small mt-2"></div>
				</div>
			</div>
		</div>
	</div>

	
	{{else}}
	<div class="text-center text-muted py-5">
		Giỏ hàng trống. <a href="/catalog" class="text-primary">Tiếp tục mua sắm</a>
	</div>
	{{/if}}
</div>


<script>
	document.addEventListener('DOMContentLoaded', function () {
		const cartTable = document.getElementById('cartTable');
		const selectAll = document.getElementById('selectAll');
		const totalElement = document.getElementById('totalAmount');
		const checkoutBtn = document.getElementById('checkoutBtn');
		const statusEl = document.getElementById('cartStatus');
		const taxEl = document.getElementById('taxAmount');
		const shipping = parseFloat(document.getElementById('shippingAmount')?.innerText.replace(/[^\d]/g, '')) || 0;


		// Định dạng tiền VNĐ
		function formatPrice(price) {
			return price.toLocaleString('vi-VN');
		}


		// Hiển thị trạng thái giỏ hàng
		function setStatus(message, type = 'info') {
			if (!statusEl) return;
			statusEl.textContent = message;
			statusEl.className = `small mt-2 text-${type}`;
		}


		// Cập nhật số lượng sản phẩm trên biểu tượng giỏ hàng ở header mà không cần tải lại trang
		function updateHeaderCartCount() {
			const badge = document.querySelector('.btn-cart .badge');
			if (!badge) return;
			const rows = document.querySelectorAll('#cartTable tbody tr');
			let sum = 0;
			rows.forEach(r => { sum += (parseInt(r.getAttribute('data-quantity') || '0') || 0); });
			badge.textContent = String(sum);
		}


		// Tính lại tổng tiền cho một dòng
		function recalcLineTotal(row) {
			const price = parseFloat(row.dataset.price) || 0;
			const quantity = parseInt(row.dataset.quantity) || 1;
			const cell = row.querySelector('.line-total');
			if (cell) cell.textContent = formatPrice(price * quantity) + ' VND';
		}


		// Cập nhật tổng tiền dựa trên các mục được chọn
		function updateTotal() {
			let subtotal = 0;
			const liveCheckboxes = document.querySelectorAll('#cartTable .item-checkbox');
			liveCheckboxes.forEach(cb => {
				if (cb.checked) {
					const row = cb.closest('tr');
					if (row) {
						const price = parseFloat(row.dataset.price) || 0;
						const quantity = parseInt(row.dataset.quantity) || 1;
						subtotal += price * quantity;
					}
				}
			});
			const tax = Math.round(subtotal * 0.10);
			if (taxEl) taxEl.textContent = `${formatPrice(tax)} VND`;
			let total = 0;
			if (subtotal > 0) {
				checkoutBtn.disabled = false;
				total = subtotal + tax + shipping;
			} else {
				checkoutBtn.disabled = true;
			}
			totalElement.textContent = `${formatPrice(total)} VND`;
		}


		// Xử lý các nút tăng/giảm số lượng
		function handleQtyButtons(row) {
			const input = row.querySelector('.qty-input');
			row.querySelectorAll('.btn-qty').forEach(btn => {
				btn.addEventListener('click', () => {
					if (row.getAttribute('data-loading') === '1') return;
					let val = parseInt(input.value) || 1;
					if (btn.dataset.action === 'inc') val += 1; else val = Math.max(1, val - 1);
					input.value = val;
					patchQuantity(row, val);
				});
			});
			input.addEventListener('change', () => {
				let val = parseInt(input.value) || 1;
				if (val < 1) val = 1;
				input.value = val;
				if (row.getAttribute('data-loading') === '1') return;
				patchQuantity(row, val);
			});
		}


		// Thiết lập trạng thái loading cho một dòng
		function setRowLoading(row, isLoading) {
			row.setAttribute('data-loading', isLoading ? '1' : '0');
			row.querySelectorAll('.btn-qty').forEach(b => { if (b instanceof HTMLButtonElement) b.disabled = !!isLoading; });
			const input = row.querySelector('.qty-input');
			if (input) input.disabled = !!isLoading;
		}


		// Gửi yêu cầu cập nhật số lượng sản phẩm
		async function patchQuantity(row, newQty) {
			const qtyInput = row.querySelector('.qty-input');
			const cartItemId = row.getAttribute('data-cart-item-id');
			const originalQty = parseInt(row.getAttribute('data-quantity') || '1');
			if (!cartItemId) return;
			if (newQty === originalQty) return; // no-op

			row.setAttribute('data-quantity', String(newQty));
			recalcLineTotal(row);
			updateTotal();
			setRowLoading(row, true);
			try {
				const variantId = row.getAttribute('data-variant-id');
				const res = await fetch(`/api/users/cart/me/${cartItemId}`, {
					method: 'PATCH',
					headers: { 'Content-Type': 'application/json' },
					credentials: 'include',
					body: JSON.stringify({ quantity: newQty, variantId })
				});
				if (!res.ok) throw new Error('Patch failed');
				updateHeaderCartCount();
			} catch (e) {
				row.setAttribute('data-quantity', String(originalQty));
				if (qtyInput) qtyInput.value = String(originalQty);
				recalcLineTotal(row);
				updateTotal();
				setStatus('Lỗi cập nhật số lượng', 'danger');
			} finally {
				setRowLoading(row, false);
			}
		}


		// Gắn sự kiện cho một dòng trong giỏ hàng
		function attachRowEvents(row) {
			handleQtyButtons(row);
			const removeBtn = row.querySelector('.btn-remove');
			const cartItemId = row.dataset.cartItemId;

			// Xóa sản phẩm
			removeBtn.addEventListener('click', async () => {
				const priceBackup = row.dataset.price;
				const qtyBackup = row.dataset.quantity;
				row.style.opacity = '0.5';
				try {
					const res = await fetch(`/api/users/cart/me/${cartItemId}`, {
						method: 'DELETE',
						credentials: 'include'
					});
					if (!res.ok) throw new Error('Delete failed');
					row.remove();
					if (!cartTable.querySelector('tbody tr')) {
						const container = document.querySelector('.container');
						container.innerHTML = '<div class="text-center text-muted py-5">Giỏ hàng trống. <a href="/catalog" class="text-primary">Tiếp tục mua sắm</a></div>';
					}
					updateTotal();
					updateHeaderCartCount();
				} catch (e) {
					row.style.opacity = '1';
					row.dataset.price = priceBackup;
					row.dataset.quantity = qtyBackup;
					setStatus('Lỗi xóa sản phẩm', 'danger');
				}
			});
		}


		// Gắn sự kiện ban đầu
		cartTable?.querySelectorAll('tbody tr').forEach(attachRowEvents);


		// Gắn sự kiện cho các checkbox và nút chọn tất cả
		const refreshCheckboxHandlers = () => {
			document.querySelectorAll('#cartTable .item-checkbox').forEach(cb => {
				cb.removeEventListener('change', updateTotal);
				cb.addEventListener('change', updateTotal);
			});
		};
		refreshCheckboxHandlers();
		selectAll?.addEventListener('change', function () {
			document.querySelectorAll('#cartTable .item-checkbox').forEach(cb => { if (cb instanceof HTMLInputElement) cb.checked = selectAll.checked; });
			updateTotal();
		});


		// Tính tổng ban đầu
		updateTotal();
		updateHeaderCartCount();


		// Thanh toán các mục đã chọn -> lưu vào sessionStorage rồi chuyển hướng
		checkoutBtn?.addEventListener('click', (e) => {
			if (checkoutBtn.disabled) return;
			const selected = [];
			document.querySelectorAll('#cartTable .item-checkbox:checked').forEach(cb => {
				const row = cb.closest('tr');
				if (!row) return;
				selected.push({
					cartItemId: row.getAttribute('data-cart-item-id'),
					variantId: row.getAttribute('data-variant-id'),
					productName: (row.querySelector('[title]')?.getAttribute('title') || '').trim(),
					distinctFeature: (row.querySelector('td.small')?.textContent || '').trim(),
					price: Number(row.getAttribute('data-price') || '0'),
					quantity: Number(row.getAttribute('data-quantity') || '1')
				});
			});
			if (!selected.length) {
				setStatus('Chưa chọn sản phẩm nào để thanh toán', 'warning');
				return;
			}
			try {
				sessionStorage.setItem('checkoutItems', JSON.stringify(selected));
				window.location.href = '/checkout';
			} catch (err) {
				setStatus('Không thể lưu dữ liệu để thanh toán', 'danger');
			}
		});
	});
</script>